<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <template id="report_payslip_inherit" inherit_id="hr_payroll.report_payslip">
        <!-- Odoo 20: header placed right after "Total" so it lines up with the cell added below -->
        <xpath expr="//div[@id='payslip_lines_table']/table/thead/tr/th[@id='line_header_total']" position="after">
            <th id="line_header_ytd_total" class="text-end">YTD Total</th>
        </xpath>
    </template>

    <!-- The payslip rows are rendered by syncoria_can_payroll's own row template (it replaces the base tbody) -->
    <template id="report_payslip_line_row_ytd" inherit_id="syncoria_can_payroll.report_payslip_line_row">
        <xpath expr="//td[@id='payslip_line_total']" position="after">
            <td id="payslip_ytd" class="text-end">
                <span t-out="o._payslip_line_ytd_total().get(line.code, 0)"
                      t-options="{'widget': 'monetary', 'display_currency': o.company_id.currency_id}"
                      t-att-style="'color:#875A7B;' if o._payslip_line_ytd_total().get(line.code, 0) &lt; 0 else ''"/>
            </td>
        </xpath>
    </template>
</odoo>
