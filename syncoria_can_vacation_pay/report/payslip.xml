<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <template id="report_payslip_inherit" inherit_id="hr_payroll.report_payslip">
<!--         <xpath expr="//div/table[2]" position="replace">-->

<!--            </xpath>-->

        <xpath expr="//table[@name='employee-infos']" position="after">
            <t t-set="vac_payslip_ids"
                   t-value="o.env['hr.vacation.pay'].search(
                    [('employee_id', '=', o.employee_id.id)]).filtered(
                    lambda x: o.date_to >= x.date)"/>
            <t t-set="cal_vac_pay"
                   t-value="o._calculate_vacation_pay(sum(vac_payslip_ids.mapped('duration')),o.contract_id)"/>
            <t t-if="vac_payslip_ids and cal_vac_pay > 0.0">
            <table name="vacation_leave_information" class="table table-sm table-bordered">
                <th colspan="4" style="text-align:center;">Vacation Pay</th>
                <t t-set="vac_report"
                   t-value="o.env['ir.config_parameter'].get_param('syncoria_can_vacation_pay.vac_report')"/>
                <tr id="vacation_leave_info_1">
                    <t t-if="vac_report in ['both', 'days']">
                        <td class="w-25">
                            <strong>Vacation Pay(Days)</strong>
                        </td>
                    </t>
                    <t t-if="vac_report in ['both', 'hours']">
                        <td class="w-25">
                            <strong>Vacation Pay(Hours)</strong>
                        </td>
                    </t>
                    <td class="w-25">
                        <strong>Accrued Amount</strong>
                    </td>
                </tr>
                <tr id="vacation_leave_info_2" style="text-align:right;">
                    <t t-set="leave_taken" t-value="o.employee_id._get_vacation_pay_calculation()"/>
                        <t t-if="vac_report in ['both', 'days']">
                            <td>
                                <span t-esc="round(o.employee_id.allocated_vacation_leave,2)"/>
                            </td>
                        </t>
                     <t t-if="vac_report in ['both', 'hours']">
                            <td>
                                <span t-esc="round((o.employee_id.allocated_vacation_leave * o.employee_id.contract_id.resource_calendar_id.hours_per_day),2)"/>
                            </td>
                        </t>
                    <td>
                        <span t-esc="round(o.calculate_remaining_vac_leave_amount(o.employee_id.allocated_vacation_leave),4)"/>
                    </td>
                </tr>
            </table>
            </t>
        </xpath>
    </template>
</odoo>

