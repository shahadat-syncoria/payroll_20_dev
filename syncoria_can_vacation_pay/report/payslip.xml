<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <template id="report_payslip_inherit" inherit_id="hr_payroll.report_payslip">
<!--         <xpath expr="//div/table[2]" position="replace">-->

<!--            </xpath>-->

        <xpath expr="//div[@id='infos_table']" position="after">

            <t t-if="o.input_line_ids.filtered(lambda worked_days: worked_days.code in ['Vacation_Pay','Adjusted_Vacation_Pay'])">

            <table name="vacation_leave_information" class="table table-sm table-borderless">

                <t t-set="vac_report"
                   t-value="o.env['ir.config_parameter'].get_param('syncoria_can_vacation_pay.vac_report')"/>
                <thead class="o_black_border">
                    <tr><th colspan="4" style="text-align:center;">Vacation Pay</th></tr>
                        <tr>
                            <t t-if="vac_report in ['both', 'days']">
                        <th class="text-end">
                            Vacation Pay(Days)
                        </th>
                    </t>
                    <t t-if="vac_report in ['both', 'hours']">
                        <th class="text-end">Vacation Pay(Hours)</th>
                    </t>
                    <th class="text-end">Accrued Amount</th>
                        </tr>
                    </thead>
                <tbody>
                    <tr id="vacation_leave_info_2" style="text-align:right;">
                    <t t-set="leave_taken" t-value="o.employee_id._get_vacation_pay_calculation()"/>
                        <t t-if="vac_report in ['both', 'days']">
                            <td>
                                <span t-esc="round(o.employee_id.allocated_vacation_leave,2)"/>
                            </td>
                        </t>
                     <t t-if="vac_report in ['both', 'hours']">
                            <td>
                                <span t-esc="round((o.employee_id.allocated_vacation_leave * o.employee_id.version_id.resource_calendar_id.hours_per_day),2)"/>
                            </td>
                        </t>
                    <td>
                        <span t-esc="round(o.ytd_vac_pay_amount,2)"/>
                    </td>
                </tr>
                </tbody>


            </table>
            </t>

        </xpath>
    </template>
</odoo>

