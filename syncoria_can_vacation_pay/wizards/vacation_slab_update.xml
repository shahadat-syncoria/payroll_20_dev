<odoo>
    <record id="view_message_wizard_form" model="ir.ui.view">
        <field name="name">message.wizard.form</field>
        <field name="model">message.wizard</field>
        <field name="arch" type="xml">
            <form string="Message">
                <group colspan="6">
                    <field name="message" readonly="1" nolabel="1" colspan="2"/>
                </group>
                <footer>
                    <button string="OK" class="btn-secondary" type="object" name="action_confirm"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
