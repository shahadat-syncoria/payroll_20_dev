<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="hr_leave_type_form_inherit" model="ir.ui.view">
            <field name="name">syncoria_can_vacation_pay.hr_leave_type.form</field>
            <field name="model">hr.work.entry.type</field>
            <field name="inherit_id" ref="hr_holidays.hr_work_entry_type_view_form"/>
            <field name="priority" eval="8"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='hide_on_dashboard']" position="after">
                    <field name="allow_vacation_pay" groups="hr_holidays.group_hr_holidays_manager,hr_holidays.group_hr_holidays_user"/>
                </xpath>
            </field>
        </record>


        <record id="ir_actions_server_delete_allocations" model="ir.actions.server">
        <field name="name">Delete Approved Allocations</field>
        <field name="model_id" ref="hr_holidays.model_hr_leave_allocation"/>
        <field name="binding_model_id" ref="hr_holidays.model_hr_leave_allocation"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
         <field name="code">
            if records:
                records.action_delete_validate()
        </field>
    </record>
    </data>
</odoo>