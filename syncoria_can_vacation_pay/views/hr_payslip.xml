<!--                            <field name="currency_id" />-->
<!--                            <field name="total_stored_overtime_amount" />-->
<!--                        </span>-->
<!--                        <span class="o_stat_value text-danger" invisible="total_stored_overtime_amount &gt;= 0">-->
<!--                            <field name="currency_id"/>-->
<!--                            <field name="total_stored_overtime_amount"/>-->
<!--                        </span>-->
<!--                        <span class="o_stat_text">Stored Overtime</span>-->
<!--                    </div>-->
<!--                </button>-->
<!--            </xpath>-->
                <xpath expr="//field[@name='struct_id']" position="after">
                    <field name="payout_vacation_pay_paycycle"/>


                </xpath>


            </field>
        </record>

    </data>
</odoo>
