<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="hr_payslip_form_vac_pay" model="ir.ui.view">
            <field name="name">hr_payslip.vac_pay.form</field>
            <field name="model">hr.payslip</field>
            <field name="inherit_id" ref="hr_payroll.view_hr_payslip_form"/>
            <!--            <field name="priority" eval="8"/>-->
            <field name="arch" type="xml">
                <div name="button_box" position="inside">
                    <field name="vacation_type" invisible="1"/>
                    <button name="%(syncoria_can_vacation_pay.hr_vacation_pay_act_window)d"
                            type="action"
                            class="oe_stat_button"

                            icon="fa-history"
                            invisible="vacation_type != 'time_wise' ">
                        <field name="vacation_pay_taken" icon="fa-money" widget="statinfo"/>
                    </button>
                    <button name="%(syncoria_can_vacation_pay.hr_vacation_pay_act_window)d"
                            type="action"
                            class="oe_stat_button"
                            context="{'search_default_employee_id': employee_id, 'search_default_state': 'paid'}"
                            icon="fa-money" invisible="vacation_type != 'cash_wise' ">

                        <field name="ytd_vac_pay_amount" icon="fa-money" widget="statinfo"/>
                    </button>
                </div>
<!--                <xpath expr="//div[@name='button_box']" position="inside">-->
<!--                  <button type="object" class="oe_stat_button" id="open_overtime"-->
<!--                    icon="fa-money" name="action_open_overtime" >-->
