<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="res_config_settings_can_vacation_pay_form_inherit" model="ir.ui.view">
            <field name="name">syncoria_can_vacation_pay.res_config_settings.form</field>
            <field name="model">res.config.settings</field>
            <field name="inherit_id" ref="hr_payroll.res_config_settings_view_form"/>
            <field name="arch" type="xml">
                <xpath expr="//div[@id='syncoria_hr_payroll']" position="after">

                     <div id="syncoria_hr_payroll_vacation_pay">
                         <h2>Vacation Pay Type</h2>
                         <div class='row mt16 o_settings_container' id='sync_payroll_vac_pay_type_div'>
                           <div class="col-12 col-lg-6 o_setting_box" id="sync_vac_pay_setting">
                                <div class="o_setting_left_pane">
                                </div>
                                <div class="o_setting_right_pane">
                                    <label for="vac_pay_type" string="Vacation pay type"/>
                                    <div class="text-muted">
                                       Vacation Pay Type
                                    </div>
                                    <div class="content-group">
                                        <div class="mt16">
                                            <field name="vac_pay_type" class="o_light_label"/>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-12 col-lg-6 o_setting_box" id="sync_payroll_vac_report_div">
                                <div class="o_setting_right_pane">
                                     <label for="vacation_report" string="Vacation Pay Count"/>
                                       <div class="text-muted">
                                           Define how the vacation pay will be displayed in payslip report
                                      </div>
                                    <div class="content-group">
                                        <div class="mt16">
                                            <field name="vacation_report" class="o_light_label" widget="radio"/>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </xpath>
            </field>
        </record>
    </data>
</odoo>