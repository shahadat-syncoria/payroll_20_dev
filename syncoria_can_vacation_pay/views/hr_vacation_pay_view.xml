<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="hr_vacation_pay_form_view" model="ir.ui.view">
            <field name="name">syncoria_can_vacation_pay.hr_vacation_pay.form</field>
            <field name="model">hr.vacation.pay</field>
            <field name="arch" type="xml">
                <form string="Vacation Pay Request">
                    <header>
                        <button string="Confirm" name="action_confirm" type="object" class="oe_highlight"
                                attrs="{'invisible': [('state', '!=', 'draft')]}"/>
                        <button string="Approve" name="action_approve" type="object" class="oe_highlight"
                                attrs="{'invisible': [('state', '!=', 'confirm')]}"
                                groups="hr_holidays.group_hr_holidays_manager"/>
                        <button string="Validate" name="action_validate" states="validate1" type="object"
                                groups="hr_holidays.group_hr_holidays_manager,hr_holidays.group_hr_holidays_user"
                                class="oe_highlight"/>
                        <button string="Refuse" name="action_refuse" type="object"
                                attrs="{'invisible': [('state', 'not in', ('confirm','cancel','validate'))]}"
                                groups="hr_holidays.group_hr_holidays_manager,hr_holidays.group_hr_holidays_user"/>
                        <button string="Cancel" name="action_cancel" type="object"
                                attrs="{'invisible': [('state', '!=', 'draft')]}"/>
                        <button string="Mark as Draft" name="action_draft" type="object"
                                attrs="{'invisible': [('state', 'not in', ['cancel', 'refuse'])]}"/>
                        <field name="state" widget="statusbar" statusbar_visible="confirm,validate"
                        />
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <label for="name" string="Reference"/>
                            <h1>
                                <field name="name" placeholder="Reference"/>
                            </h1>
                        </div>
                        <group>
                        <group string="Employee Information">
                            <field name="employee_id"
                                   groups="hr_holidays.group_hr_holidays_manager,hr_holidays.group_hr_holidays_user"/>
                            <field name="department_id"/>
                            <field name="job_id"/>
                            <field name="contract_id"/>
                            <field name="description"/>
                        </group>
                        <group string="Vacation Pay Request Information">
                            <field name="date" readonly="1"/>
                            <field name="vacation_pay_amount" invisible="1"/>
                            <field name="duration" attrs="{'readonly':[('state','!=','draft')]}"/>
                            <field name="vacation_remain" />
                            <field name="is_last_pay" string="Is employee Quiting?" groups="hr_holidays.group_hr_holidays_manager,hr_holidays.group_hr_holidays_user"/>

                        </group>
                        </group>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids" groups="base.group_user"/>
                        <field name="activity_ids"/>
                        <field name="message_ids"/>
                    </div>
                </form>
            </field>
        </record>

        <record id="hr_vacation_pay_tree_view" model="ir.ui.view">
            <field name="name">syncoria_can_vacation_pay.hr_vacation_pay.tree</field>
            <field name="model">hr.vacation.pay</field>
            <field name="arch" type="xml">
                <tree string="Vacation Pay Request">
                    <field name="name"/>
                    <field name="employee_id"/>
                    <field name="duration" sum="Total Duration"/>
                    <field name="state" widget="badge" decoration-info="state == 'draft'"
                           decoration-warning="state in ('refuse','cancel')"
                           decoration-success="state == state in ('validate','paid')"/>
                </tree>
            </field>
        </record>

        <record id="hr_vacation_pay_search_view" model="ir.ui.view">
            <field name="name">syncoria_can_vacation_pay.hr_vacation_pay.search</field>
            <field name="model">hr.vacation.pay</field>
            <field name="arch" type="xml">
                <search string="Vacation Pay Request">
                    <field name="employee_id"/>
                    <group expand="1" string="Group By">
                        <filter string="Employee" name="group_employee_id" domain="[]"
                                context="{'group_by':'employee_id'}"/>
                    </group>
                </search>
<!--                <searchpanel>-->
<!--                    <field name="state" string="Status"/>-->
<!--                    <field name="department_id" string="Department"/>-->
<!--                </searchpanel>-->
            </field>
        </record>
        <record id="hr_vacation_pay_act_window" model="ir.actions.act_window">
            <field name="name">Vacation Pay Request</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">hr.vacation.pay</field>
            <field name="view_mode">tree,form</field>
            <field name="context">{}</field>
            <field name="help" type="html">
                <p class="oe_view_nocontent_create">
                    There is no examples click here to add new Vacation Pay Request.
                </p>
            </field>
        </record>
        <menuitem name="Vacation Pay Request" id="hr_vacation_pay_menu" parent="hr_holidays.menu_hr_holidays_my_leaves"
                  action="hr_vacation_pay_act_window" sequence="10"/>
    </data>
</odoo>