<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="hr_vacation_pay_form_view" model="ir.ui.view">
            <field name="name">syncoria_can_vacation_pay.hr_vacation_pay.form</field>
            <field name="model">hr.vacation.pay</field>
            <field name="arch" type="xml">
                <form string="Vacation Pay Request">
                    <header>
                        <button class="oe_highlight" invisible="state != 'draft'" name="action_confirm" string="Confirm" type="object"/>
                        <button class="oe_highlight" groups="hr_holidays.group_hr_holidays_manager" invisible="state != 'confirm'" name="action_approve" string="Approve" type="object"/>
                        <button class="oe_highlight" groups="hr_holidays.group_hr_holidays_manager,hr_holidays.group_hr_holidays_user" invisible="state not in ['validate1']" name="action_validate" string="Validate" type="object"/>
                        <button groups="hr_holidays.group_hr_holidays_manager,hr_holidays.group_hr_holidays_user" invisible="state not in ('confirm', 'cancel', 'validate')" name="action_refuse" string="Refuse" type="object"/>
                        <button invisible="state != 'draft'" name="action_cancel" string="Cancel" type="object"/>
                        <button invisible="state not in ['cancel', 'refuse']" name="action_draft" string="Mark as Draft" type="object"/>
                        <field name="state" statusbar_visible="confirm,validate" widget="statusbar"/>
                    </header>
                    <sheet>

                        <div class="oe_title">
                            <label for="name" string="Reference"/>
                            <h1>
                                <field name="name" placeholder="Reference"/>
                            </h1>
                        </div>
                        <group>
                            <group string="Employee Information">
                                <field groups="hr_holidays.group_hr_holidays_manager,hr_holidays.group_hr_holidays_user" name="employee_id"/>
                                <field name="department_id"/>
                                <field name="job_id"/>
                                <field name="contract_id"/>
                                <field name="description"/>
                            </group>
                            <group string="Vacation Pay Request Information">
                                <field name="date" readonly="0"/>
                                <field name="vacation_type"/>
                                <field invisible="vacation_type != 'cash_wise'" readonly="state != 'draft'" name="vacation_pay_amount_remaining"/>
                                <field invisible="vacation_type != 'cash_wise'" readonly="state != 'draft'" name="vacation_pay_amount"/>
                                <field name="duration" readonly="state != 'draft'" invisible="vacation_type != 'time_wise'"/>
                                <field name="vacation_remain" invisible="vacation_type != 'time_wise' "/>
                                <field groups="hr_holidays.group_hr_holidays_manager,hr_holidays.group_hr_holidays_user" name="is_last_pay" string="Is employee Quitting?"/>
                            </group>
                        </group>
                    </sheet>
                    <div class="oe_chatter">
                        <field groups="base.group_user" name="message_follower_ids"/>
                        <field name="activity_ids"/>
                        <field name="message_ids"/>
                    </div>
                </form></field>
        </record>
        <record id="hr_vacation_pay_tree_view" model="ir.ui.view">
            <field name="name">syncoria_can_vacation_pay.hr_vacation_pay.tree</field>
            <field name="model">hr.vacation.pay</field>
            <field name="arch" type="xml">
                <tree string="Vacation Pay Request">
                    <field name="name"/>
                    <field name="employee_id"/>
                    <field name="duration" sum="Total Duration"/>
                    <field decoration-info="state == 'draft'" decoration-success="state == state in ('validate','paid')" decoration-warning="state in ('refuse','cancel')" name="state" widget="badge"/>
                </tree></field>
        </record>
        <record id="hr_vacation_pay_search_view" model="ir.ui.view">
            <field name="name">syncoria_can_vacation_pay.hr_vacation_pay.search</field>
            <field name="model">hr.vacation.pay</field>
            <field name="arch" type="xml">
                <search string="Vacation Pay Request">
                    <field name="employee_id"/>
                    <group expand="1" string="Group By">
                        <filter context="{'group_by':'employee_id'}" domain="[]" name="group_employee_id" string="Employee"/>
                    </group>
                </search>
                <!--                <searchpanel>-->
                <!--                    <field name="state" string="Status"/>-->
                <!--                    <field name="department_id" string="Department"/>-->
                <!--                </searchpanel>--></field>
        </record>
        <record id="hr_vacation_pay_act_window" model="ir.actions.act_window">
            <field name="name">Vacation Pay Request</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">hr.vacation.pay</field>
            <field name="view_mode">tree,form</field>
            <field name="context">{}</field>
            <field name="help" type="html">
                <p class="oe_view_nocontent_create">
                    There is no examples click here to add new Vacation Pay Request.
                </p></field>
        </record>
        <menuitem action="hr_vacation_pay_act_window" id="hr_vacation_pay_menu" name="Vacation Pay Request" parent="hr_holidays.menu_hr_holidays_my_leaves" sequence="10"/>
    </data>
</odoo>
