<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="hr_employee_form_inherit" model="ir.ui.view">
            <field name="name">syncoria_can_vacation_pay.hr_employee.form</field>
            <field name="model">hr.employee</field>
            <field name="inherit_id" ref="hr.view_employee_form"/>
            <!--            <field name="priority" eval="8"/>-->
            <field name="arch" type="xml">


                <div name="button_box" position="inside">
                    <button name="%(syncoria_can_vacation_pay.hr_vacation_pay_act_window)d"
                            type="action"
                            class="oe_stat_button"
                            context="{'search_default_employee_id': active_id, 'search_default_state': 'paid'}"
                            icon="fa-history">
                        <field name="vacation_pay_taken" icon="fa-money" widget="statinfo"/>
                    </button>
                </div>

                <xpath expr="//group[@name='active_group']" position="after">
                    <group string="Vacation Information">
                    <label for="vacation_pay_allocation_start"/>
                    <div class="o_row">
                        <field name="vacation_pay_allocation_start"/>
                        <span class="text-muted">month</span>
                    </div>

                    <field name="previous_allocated_vacation_leave"/>
                     <label for="allocated_vacation_leave"/>
                     <div class="o_row">
                         <field name="allocated_vacation_leave"/>
                        <span class="text-muted">days</span>
                    </div>

                        <field name="is_adjust_vacation_pay_leave"/>
                     </group>



                </xpath>

            </field>
        </record>

<!--        ========================== Syncoria Canada Payroll Employee View  ================================-->
          <record id="view_employee_form_vac_pay" model="ir.ui.view">
            <field name="model">hr.employee</field>
            <field name="inherit_id" ref="syncoria_can_payroll.view_employee_form_sync_can_view"/>
            <field name="arch" type="xml">
                <xpath expr="//page[@name='sync_payroll_info']/group" position="inside">
                    <group string='Vacation Pay(Earned Pay)' name="vacation_pay">
                        <group>
                            <field name="ytd_vac_pay_amount_erp" readonly="1"/>
                            <field name="previous_vac_pay_amount"/>
                            <field name="ytd_vac_pay_amount"/>
                            <field name="vac_pay_amount_taken"/>
                        </group>
                        <group>
                                            <button name="update_vac_pay_amount_erp" type="object"
                                                    help="Update Vacation Amount" title="Update Vacation Amount" icon="fa-refresh"/>

                                        </group>


                    </group>
                </xpath>
            </field>
          </record>
    </data>
</odoo>