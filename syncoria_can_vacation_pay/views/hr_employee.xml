<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="hr_employee_form_inherit" model="ir.ui.view">
            <field name="name">syncoria_can_vacation_pay.hr_employee.form</field>
            <field name="model">hr.employee</field>
            <field name="inherit_id" ref="hr.view_employee_form"/>
            <!--            <field name="priority" eval="8"/>-->
            <field name="arch" type="xml">
                <div name="button_box" position="inside">
                    <field name="vacation_type" invisible="1"/>
                    <button name="%(syncoria_can_vacation_pay.hr_vacation_pay_act_window)d"
                            type="action"
                            class="oe_stat_button"
                            context="{'search_default_employee_id': active_id, 'search_default_state': 'paid'}"
                            icon="fa-history"
                            invisible="vacation_type != 'time_wise' ">
                        <field name="vacation_pay_taken" icon="fa-money" widget="statinfo"/>
                    </button>
                    <button name="%(syncoria_can_vacation_pay.hr_vacation_pay_act_window)d"
                            type="action"
                            class="oe_stat_button"
                            context="{'search_default_employee_id': active_id, 'search_default_state': 'paid'}"
                            icon="fa-money" invisible="vacation_type != 'cash_wise' ">

                        <field name="ytd_vac_pay_amount" icon="fa-money" widget="statinfo"/>
                    </button>
                </div>

                <xpath expr="//group[@name='active_group']" position="after">
                    <group string="Vacation Information">
                    <label for="vacation_pay_allocation_start"/>
                    <div class="o_row">
                        <field name="vacation_pay_allocation_start"/>
                        <span class="text-muted">month</span>
                    </div>

                    <field name="previous_allocated_vacation_leave"/>
                     <label for="allocated_vacation_leave"/>
                     <div class="o_row">
                         <field name="allocated_vacation_leave"/>
                        <span class="text-muted">days</span>
                    </div>
                        <field name="allocated_vac_percentage"/>
                        <field name="is_adjust_vacation_pay_leave"/>
                        <field name="is_vacation_pay_adjust_negative" invisible="not is_adjust_vacation_pay_leave"/>
                        <field name="payout_vacation_pay_paycycle" />
                     </group>



                </xpath>
                <xpath expr="//notebook" position="inside">
                    <page name="sync_payroll_vac_info" string="Vacation Slab Information" groups="hr.group_hr_manager">
                                    <group string="Vacation Slab Configuration">
                                        <field name="vacation_slab_ids" no_label="1" >
                                            <tree>
                                                <field name="start_year" />
                                                <field name="end_year" />
                                                <field name="allocated_leave" />
                                                <field name="leave_percentage" />
                                            </tree>
                                        </field>
                                </group>
                        <group string="Accounting For Accrued Vacation pay">
                            <field name="account_debit" />
                            <field name="account_credit"/>
                        </group>
                            </page>
                </xpath>

            </field>
        </record>

        <record id="view_employee_form_vac_pay" model="ir.ui.view">
            <field name="model">hr.employee</field>
            <field name="inherit_id" ref="syncoria_can_payroll.view_employee_form_sync_can_view"/>
            <field name="arch" type="xml">
                <xpath expr="//notebook/page[@name='sync_payroll_info']" position="inside">

                </xpath>
            </field>
        </record>

        <record id="view_employee_form_vac_pay_ytd" model="ir.ui.view">
            <field name="model">hr.employee</field>
            <field name="inherit_id" ref="syncoria_can_payroll.view_employee_form_sync_can_view"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='payroll_line_ids']/tree/field[@name='ytd_pi']" position="after">
                    <field name="ytd_vac_pay_amount"/>
                </xpath>
                <xpath expr="//field[@name='payroll_line_ids']/form/group[2]" position="inside">
                    <group string='Vacation Pay(Earned Pay)' name="vacation_pay">
                        <label for="ytd_vac_pay_amount_erp" class="oe_inline"/>
                        <div class="o_row">
                            <field name="ytd_vac_pay_amount_erp"/>
                            <button name="update_vac_pay_amount_erp" type="object" title="Update Vacation Amount"
                                    help="Update Vacation Amount" icon="fa-refresh"/>
                        </div>
                        <field name="previous_vac_pay_amount"/>
                        <field name="ytd_vac_pay_amount"/>
                        <field name="vac_pay_amount_taken"/>
                    </group>
                </xpath>
            </field>
          </record>

    </data>
</odoo>