<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hr_vacation_rule_employee" model="ir.rule">
        <field name="name">Vacation Pay base.group_user read</field>
        <field name="model_id" ref="model_hr_vacation_pay"/>
        <field name="domain_force">[('employee_id.user_id', '=', user.id)]</field>
        <field name="perm_create" eval="False"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_unlink" eval="False"/>
        <field name="groups" eval="[(4,ref('base.group_user'))]"/>
    </record>
    <record id="hr_vacation_rule_payslip" model="ir.rule">
        <field name="name">Vacation Pay base.group_hr_manager</field>
        <field name="model_id" ref="model_hr_vacation_pay"/>
        <field name="domain_force">[]</field>
        <field name="groups" eval="[(4,ref('hr_holidays.group_hr_holidays_manager'))]"/>
    </record>
    <record id="hr_vacation_rule_user_read" model="ir.rule">
        <field name="name">Vacation Pay All Approver read</field>
        <field name="model_id" ref="model_hr_vacation_pay"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
        <field name="groups" eval="[(4, ref('hr_holidays.group_hr_holidays_user'))]"/>
    </record>
</odoo>