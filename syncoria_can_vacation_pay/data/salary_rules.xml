<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

<!--        ======================== Employee ====================-->
        <record id="rule_ca_vacation_pay" model="hr.salary.rule">
            <field name="country_id" ref="base.ca"/>
            <field name="name">Vacation Pay</field>
            <field name="sequence" eval="30"/>
            <field name="code">VP</field>
            <field name="category_ids" eval="[(6, 0, [ref('syncoria_can_payroll.additional_allowance')])]"/>
            <field name="appears_on_payslip" eval="'always'"/>
            <field name="active" eval="1"/>
            <field name="amount_select">code</field>
            <field name="struct_ids" eval="[(6, 0, [ref('syncoria_can_payroll.structure_can_employee')])]"/>
            <field name="input_usage_payslip" eval="1"/>
            <field name="condition_select">python</field>
                    <field name="condition_python">result = 'VP' in inputs</field>

            <field name="amount_python_compute">
result = inputs['VP'].amount
result_name = inputs['VP'].name
            </field>


        </record>
         <record id="rule_ca_adjusted_vacation_pay" model="hr.salary.rule">
            <field name="country_id" ref="base.ca"/>
            <field name="name">Adjusted Vacation Pay</field>
            <field name="sequence" eval="88"/>
            <field name="code">ADJUST_VP</field>
            <field name="category_ids" eval="[(6, 0, [ref('syncoria_can_payroll.additional_allowance')])]"/>
            <field name="appears_on_payslip" eval="'always'"/>
            <field name="active" eval="1"/>
            <field name="amount_select">code</field>
            <field name="struct_ids" eval="[(6, 0, [ref('syncoria_can_payroll.structure_can_employee')])]"/>
            <field name="input_usage_payslip" eval="1"/>
            <field name="condition_select">python</field>
                    <field name="condition_python">result = payslip.payout_vacation_pay_paycycle or 'ADJUST_VP' in inputs</field>

            <field name="amount_python_compute">
employee._get_employee_allocated_leave()
final_result = 0.0
if payslip.payout_vacation_pay_paycycle:
    for code, values in result_rules.items():
        rule_obj = payslip.struct_id.rule_ids.filtered(lambda r: r.code == code)
        if rule_obj and rule_obj.is_vacation_pay:
            final_result += values.get('total', 0.0)
    insurable_amount = final_result
    vac_percentage = employee.allocated_vac_percentage
    result= (insurable_amount*(vac_percentage/100))
elif 'ADJUST_VP' in inputs:
    result = inputs['ADJUST_VP'].amount
result_rate = 100
result_qty = 1
            </field>


        </record>

        <record id="rule_ca_accrued_vacation_pay" model="hr.salary.rule">
            <field name="country_id" ref="base.ca"/>
            <field name="name">Accrued Vacation Pay</field>
            <field name="sequence" eval="400"/>
            <field name="code">ACCRUED_VP</field>
            <field name="category_ids" eval="[(6, 0, [ref('syncoria_can_vacation_pay.vac_accrued')])]"/>
            <field name="appears_on_payslip" eval="'always'"/>
            <field name="active" eval="1"/>
            <field name="amount_select">code</field>
            <field name="struct_ids" eval="[(6, 0, [ref('syncoria_can_payroll.structure_can_employee')])]"/>
            <field name="condition_select">python</field>
                    <field name="condition_python">result = not payslip.payout_vacation_pay_paycycle</field>

            <field name="amount_python_compute">
employee._get_employee_allocated_leave()
final_result = 0.0

for code, values in result_rules.items():
    rule_obj = payslip.struct_id.rule_ids.filtered(lambda r: r.code == code)
    if rule_obj and rule_obj.is_vacation_pay:
        final_result += values.get('total', 0.0)
insurable_amount = final_result
vac_percentage = employee.allocated_vac_percentage
result= (insurable_amount*(vac_percentage/100))
result_rate = 100
result_qty = 1
            </field>


        </record>


