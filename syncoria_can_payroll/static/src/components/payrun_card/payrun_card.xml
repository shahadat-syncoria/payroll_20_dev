<?xml version="1.0" encoding="UTF-8"?>
<templates>

      <t t-name="syncoria_can_payroll.PayRunCard" t-inherit="hr_payroll.PayRunCard" t-inherit-mode="extension">
        <t t-set-slot="confirm" position="replace">
            <t t-set-slot="confirm" isVisible="payrun.state == '01_ready' &amp;&amp; !payrun.empty_payslips">
                <ViewButton className="'btn btn-primary'"
                            clickParams="{type: 'object', name: 'action_draft_entry_wizard', context: {payslip_generate_pdf: true}}"
                            record="props.record"
                            string.translate="Create Draft Entry"/>
            </t>
        </t>
    </t>

</templates>