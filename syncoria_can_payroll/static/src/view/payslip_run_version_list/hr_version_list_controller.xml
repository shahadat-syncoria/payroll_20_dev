<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="syncoria_can_payroll.VersionPayrunListController.Buttons"
       t-inherit="hr_payroll.VersionPayrunListController.Buttons"
       t-inherit-mode="extension">

        <!-- Add your button -->
        <xpath expr="//button[@t-on-click='generatePayslips']" position="replace">
            <button class="btn btn-primary"
                    t-on-click="selectEmployees" t-att-disabled="model.root.selection.length &lt; 1 || state.disabled">
                Manually Generate Payslips
            </button>
        </xpath>

    </t>
</templates>

