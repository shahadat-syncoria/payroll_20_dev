<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <record id="email_template_for_payslip" model="mail.template">
            <field name="name">Payslip</field>
            <field name="model_id" ref="syncoria_can_payroll.model_hr_payslip"/>
            <field name="subject">{{ object.company_id.name }} Order (Ref {{ object.name or 'n/a' }})</field>
            <field name="partner_to">{{ object.employee_id.partner_id.id }}</field>
            <field name="description">Sent manually payslip to employee</field>
            <field name="body_html" type="html">
            <div style="margin: 0px; padding: 0px;">
                <p style="margin: 0px; padding: 0px; font-size: 13px;">
                    Dear <t t-out="object.employee_id.partner_id.name or ''">Brandon Freeman</t>
                    <t t-if="object.employee_id.partner_id.parent_id">
                        (<t t-out="object.employee_id.partner_id.parent_id.name or ''">Azure Interior</t>)
                    </t>
                    <br/><br/>
                    Here is in attachment a request for quotation <span style="font-weight:bold;" t-out="object.name or ''">P00015</span>
                    from <t t-out="object.company_id.name or ''">YourCompany</t>.
                    <br/><br/>
                    If you have any questions, please do not hesitate to contact us.
                    <br/><br/>
                    Best regards,
                    <t t-if="not is_html_empty(object.employee_id.user_id.signature)">
                        <br/><br/>
                        <t t-out="object.user_id.signature or ''">--<br/>Mitchell Admin</t>
                    </t>
                </p>
            </div></field>
            <field name="report_template_ids" eval="[(4, ref('hr_payroll.action_report_payslip'))]"/>
            <field name="lang">{{ object.employee_id.partner_id.lang }}</field>
            <field name="auto_delete" eval="True"/>
        </record>
    </data>
</odoo>
