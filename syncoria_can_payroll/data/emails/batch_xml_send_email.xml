<odoo>
    <data noupdate="0">
        <record id="email_template_batch_xml" model="mail.template">
            <field name="name">Batch XML template</field>
            <field name="model_id" ref="syncoria_can_payroll.model_statement_remuneration"/>
            <field name="subject">Batch XML attachment</field>
            <field name="email_from">{{ object.company_id.email }}</field>
            <field name="email_to">{{ object.env.user.email }}</field>
            <field name="body_html" type="html">
                <div style="margin: 0px; padding: 0px;">
                    <p style="margin: 0px; padding: 10px; font-size: 13px;">
                 Greetings ,<br></br>
                    Here are the batch XML.
                    </p>
                    <br></br>
                    Regards<br></br>
                    Administration
                </div>
            </field>
        </record>
    </data>

</odoo>