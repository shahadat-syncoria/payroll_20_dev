<odoo>
    <data noupdate="0">
        <record id="email_template_batch_xml" model="mail.template">
            <field name="name">Batch XML template</field>
            <field name="model_id" ref="syncoria_can_payroll.model_statement_remuneration"/>
            <field name="subject">Batch XML attachment</field>
            <field name="email_from">{{ object.company_id.email }}</field>
            <field name="email_to">{{ object.env.user.email }}</field>
            <field name="body_html" type="html">
                <div style="margin: 0px; padding: 0px;">
                    <p style="margin: 0px; padding: 10px; font-size: 13px;">
                 Greetings ,<br></br>
                    Here are the batch XML.
                    </p>
                    <br></br>
                    Regards<br></br>
                    Administration
                </div>
            </field>
        </record>

        <record id="email_template_for_payslip4" model="mail.template">
            <field name="name">Payslip</field>
            <field name="model_id" ref="syncoria_can_payroll.model_hr_payslip"/>
            <field name="subject">{{ object.company_id.name }} Order (Ref {{ object.name or 'n/a' }})</field>
            <field name="partner_to">{{ object.employee_id.work_contact_id.id }}</field>
            <field name="description">Sent manually payslip to employee</field>
             <field name="body_html" type="html">
                <table border="0" cellpadding="0" cellspacing="0" style="width:100%; margin:0px auto;"><tbody>
                    <tr><td valign="top" style="text-align: left; font-size: 14px;">
                        Dear <t t-esc="object.employee_id.name"></t>, a new payslip is available for you.<br/><br/>
                        Please find the PDF in your employee portal.<br/><br/>
                        Have a nice day,<br/>
                        The HR Team
                    </td></tr>
                </tbody></table>
             </field>
            <field name="report_template_ids" eval="[(4, ref('hr_payroll.action_report_payslip'))]"/>
            <field name="lang">{{ object.employee_id.lang }}</field>
            <field name="auto_delete" eval="True"/>
        </record>

    </data>

</odoo>