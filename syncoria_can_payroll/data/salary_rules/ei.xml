<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <record id="rule_ca_ei" model="hr.salary.rule">
            <field name="name">EI</field>
            <field name="sequence" eval="110"/>
            <field name="code">EI</field>
            <field name="category_id" ref="hr_payroll.DED"/>
            <field name="appears_on_payslip" eval="1"/>
            <field name="active" eval="1"/>
<!--            <field name="condition_select">none</field>-->
            <field name="amount_select">code</field>
            <field name="struct_id" ref="syncoria_can_payroll.structure_can_employee"/>
<!--            <field name="exemption_id" ref="cpp_exempt"/>-->
            <field name="amount_python_compute">
                <![CDATA[

main_gross = I_Earning
line_obj = employee.payroll_line_ids.filtered(lambda x: x.year == str(payslip.date_to.year))
calculation_1 =   employee.deductions.ei_max_emp_anu_prem - line_obj.ytd_ei ;
calculation_2 =   (employee.deductions.ei_rate / 100) * main_gross
final_ei = min(calculation_1,calculation_2)
if final_ei < 0.00:
    result = 0.00
else:
    result=final_ei



                ]]>
            </field>
        </record>

