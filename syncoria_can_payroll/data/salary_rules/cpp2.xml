<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="rule_ca_cpp2" model="hr.salary.rule">
            <field name="name">CPP2</field>
            <field name="sequence" eval="95"/>
            <field name="code">CPP2</field>
            <field name="category_id" ref="hr_payroll.DED"/>
            <field name="appears_on_payslip" eval="1"/>
            <field name="active" eval="1"/>
            <field name="amount_select">code</field>
            <field name="struct_id" ref="syncoria_can_payroll.structure_can_employee"/>
<!--            <field name="condition_select">none</field>-->
<!--            <field name="exemption_id" ref="cpp_exempt"/>-->
            <field name="amount_python_compute">
                <![CDATA[
is_pay_cycle = contract.salary_pay_cycle.pay_cycle
if is_pay_cycle:
    pay_cycle = int(is_pay_cycle)


    irregular_gross = I_Earning
    main_gross = GROSS + irregular_gross
    PM= 12
    calculation_1 =  contract.deductions.cpp2_emp_employ_contrib * (PM/12) - employee.ytd_cpp2
    W = max(employee.ytd_pi,contract.deductions.cpp_max_an_pen_earn)
    calculation_2 =  (employee.ytd_pi + main_gross - W) * (contract.deductions.cpp2_emp_employ_rate / 100)
    final_cpp2 = min(calculation_1,calculation_2)
    if final_cpp2 < 0.00:
        result = 0.00
    else:
         result=final_cpp2 if CPP <= 0 else 0.00
else:
    result=0.00
                    ]]>
            </field>


        </record>
        <record id="rule_ca_cpp2_employer" model="hr.salary.rule">
            <field name="name">Employer CPP2</field>
            <field name="sequence" eval="135"/>
            <field name="code">CPP2_EMPLOYER</field>
            <field name="category_id" ref="hr_payroll.COMP"/>
            <field name="appears_on_payslip" eval="1"/>
            <field name="active" eval="1"/>
            <field name="amount_select">code</field>
            <field name="struct_id" ref="syncoria_can_payroll.structure_can_employee"/>
<!--            <field name="condition_select">none</field>-->
<!--            <field name="exemption_id" ref="cpp_exempt"/>-->
            <field name="amount_python_compute">
                <![CDATA[
result=CPP2
                    ]]>
            </field>


        </record>



