        </record>

<!--        ========================= NET PAY =================-->
     <record id="rule_ca_net" model="hr.salary.rule">
            <field name="name">NET</field>
            <field name="sequence" eval="350"/>
            <field name="code">NET</field>
            <field name="category_id" ref="hr_payroll.NET"/>
            <field name="appears_on_payslip" eval="1"/>
            <field name="active" eval="1"/>
            <field name="amount_select">code</field>
            <field name="struct_id" ref="syncoria_can_payroll.structure_can_employee"/>
<!--            <field name="condition_select">none</field>-->
<!--            <field name="exemption_id" ref="cpp_exempt"/>-->
            <field name="amount_python_compute">
                <![CDATA[
result = (categories['GROSS'] + categories['ALW']+categories['ADD_ALLOWANCE']) - (categories['DED']+categories['PRE_TAX_DEDUCTION']+categories['POST_TAX_DEDUCTION'])

                    ]]>
            </field>


        </record>

        <!--        ============================ UNPAID ===================-->
        <record id="rule_ca_unpaid_pay" model="hr.salary.rule">
            <field name="name">Unpaid</field>
            <field name="sequence" eval="300"/>
            <field name="code">UNPAID_PAY</field>
            <field name="category_id" ref="hr_payroll.DED"/>
            <field name="appears_on_payslip" eval='True'/>
            <field name="active" eval="1"/>
            <field name="amount_select">code</field>
            <field name="struct_id" ref="syncoria_can_payroll.structure_can_employee"/>
            <field name="condition_select">python</field>
            <field name="condition_python">
unpaid = worked_days['LEAVE90']
result = 'LEAVE90' in worked_days and not unpaid.work_entry_type_id.deduct_from_gross
            </field>

            <field name="amount_python_compute">
result = abs(worked_days['LEAVE90'].amount)
result_name = worked_days['LEAVE90'].name
            </field>
        </record>


