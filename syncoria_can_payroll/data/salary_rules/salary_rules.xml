        <!--        ============================ INSURABLE EARNING ===================-->
        <record id="rule_ca_insurable_earning" model="hr.salary.rule">
            <field name="name">Insurable Earning</field>
            <field name="sequence" eval="89"/>
            <field name="code">I_Earning</field>
            <field name="category_id" ref="syncoria_can_payroll.CALC"/>
            <field name="appears_on_payslip" eval="1"/>
            <field name="active" eval="1"/>
            <field name="amount_select">code</field>
            <field name="struct_id" ref="syncoria_can_payroll.structure_can_employee"/>
            <field name="condition_select">none</field>
            <field name="amount_python_compute">
gross = 0.0
vp = 0.0
ad_vp = 0.0
bonus = 0.0
retro = 0.0
ot =0.0
b_ot = 0.0
com = 0.0
stat_ot = 0.0
exp = 0.0
final_result =0.0

for rule in rules:
    if rules[rule].is_insurable_earning:
        rule_code = rules[rule].code
        if rule_code == 'GROSS':
            gross = GROSS
        elif rule_code == 'ADJUST_VP':
            ad_vp = ADJUST_VP
        elif rule_code == 'VP':
            vp = VP
        elif rule_code == 'BONUS':
            bonus = BONUS
        elif rule_code == 'RETRO':
            retro = RETRO
        elif rule_code == 'OVERTIME':
            ot = OVERTIME
        elif rule_code == 'BANKED_OVERTIME':
            b_ot = BANKED_OVERTIME
        elif rule_code == 'COMMISSION':
            com = COMMISSION
        elif rule_code == 'STAT_OVERTIME':
            stat_ot = STAT_OVERTIME
        elif rule_code == 'EXPENSE':
            exp = EXPENSE

        final_result = gross+ vp+ ad_vp+ bonus+ ot+ retro+ b_ot+ com+ stat_ot + exp

result = final_result
            </field>


        </record>


