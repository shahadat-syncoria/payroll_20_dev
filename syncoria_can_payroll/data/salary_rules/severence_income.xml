<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <record id="input_ca_severance_pay" model="hr.payslip.input.type">
            <field name="name">Severance Pay</field>
            <field name="code">Severance_pay</field>
            <field name="country_id" eval="False"/>
        </record>


        <record id="rule_ca_severance_pay" model="hr.salary.rule">
            <field name="name">Severance Pay</field>
            <field name="sequence" eval="50"/>
            <field name="code">Severance_pay</field>
            <field name="category_id" ref="syncoria_can_payroll.additional_allowance"/>
            <field name="appears_on_payslip" eval='True'/>
            <field name="active" eval="1"/>
            <field name="amount_select">code</field>
            <field name="struct_id" ref="syncoria_can_payroll.structure_can_employee"/>
            <field name="condition_select">python</field>
            <field name="condition_python">result = 'Severance_pay' in inputs</field>
            <field name="amount_python_compute"><![CDATA[
result = inputs['Severance_pay'].amount
result_name = inputs['Severance_pay'].name
]]></field>
        </record>

        <record id="rule_ca_income_tax" model="hr.salary.rule">
            <field name="name">Income Tax</field>
            <field name="sequence" eval="250"/>
            <field name="code">Income_Tax</field>
            <field name="category_id" ref="hr_payroll.DED"/>
            <field name="appears_on_payslip" eval='True'/>
            <field name="active" eval="1"/>
            <field name="amount_select">code</field>
            <field name="struct_id" ref="syncoria_can_payroll.structure_can_employee"/>
            <field name="condition_select">python</field>
            <field name="condition_python">result = 'Severance_pay' in inputs</field>
            <field name="amount_python_compute"><![CDATA[
severance_amount = inputs['Severance_pay'].amount

severance_tax = 0.0

if severance_amount > 0.0:
    if severance_amount <= 5000:
        severance_tax = severance_amount * 0.10
    elif severance_amount <= 15000:
        severance_tax = severance_amount * 0.20
    else:
        severance_tax = severance_amount * 0.30

result = severance_tax
]]></field>
        </record>

    </data>
</odoo>
