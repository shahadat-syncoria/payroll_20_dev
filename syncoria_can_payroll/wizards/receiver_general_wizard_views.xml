<odoo>
    <data>
        <record id="receiver_general_wizard_form" model="ir.ui.view">
            <field name="name">remittance.summary.form</field>
            <field name="model">receiver.general.wizard</field>
            <field name="arch" type="xml">
                <form string="Receiver General Report">
                    <group>
                        <group>
                            <field name="date_from" required="1"/>
                            <field name="date_to" required="1"/>
                        </group>
                        <group>
                            <field name="paygroup" required="1"/>

                        </group>

                    </group>
                    <footer>
                        <button string="Print" type="object" name="print_report" class="oe_highlight"/>
                        <button string="Cancel" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>
        <record id="action_receiver_general_wizard" model="ir.actions.act_window">
            <field name="name">Receiver General Report</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">receiver.general.wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>

    </data>
</odoo>