<odoo>
    <data>
        <record id="payroll_earning_wizard_form" model="ir.ui.view">
            <field name="name">payroll.earning.wizard.form</field>
            <field name="model">payroll.earning.wizard</field>
            <field name="arch" type="xml">
                <form string="Employee Net pay">
                    <group>

                        <group>
                            <field name="date_from" required="1" />
                            <field name="date_to" required="1"/>
                        </group>
                         <group>
                            <field name="payslip_state" required="1" />
                        </group>
                    </group>
                     <group>
                         <p style="color:#888888; font-style:italic;">
                                    Note: Payslips in <strong>Draft</strong> and <strong>Cancelled</strong> states are excluded from the "All" selection.
                                </p>
                    </group>
                    <footer>
                        <button string="PDF File" type="object" name="print_report" class="oe_highlight"/>
                        <button name="get_xlsx_report" string="XLSX File" type="object" class="btn-secondary"/>
                        <button string="Cancel" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>
        <record id="action_payroll_earning_wizard" model="ir.actions.act_window">
            <field name="name">Payroll Earning Report</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">payroll.earning.wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>

    </data>
</odoo>