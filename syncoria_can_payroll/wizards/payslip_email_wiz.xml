<odoo>
    <record id="view_payslip_email_wizard_form" model="ir.ui.view">
        <field name="name">payslip.email.wizard.form</field>
        <field name="model">payslip.email.wizard</field>
        <field name="arch" type="xml">
            <form string="Message">
                <field name="is_show_warning" invisible="1"/>
                <p invisible="not is_show_warning" style="color: #6e6e16;text-align: center">Warning: Draft and Canceled entries are not eligible to be sent.</p>
                <group colspan="6">
                    <field name="employee_ids" readonly="1" force_save="1" widget="many2many_tags"/>
                    <field name="payslip_ids" readonly="1" force_save="1" widget="many2many_tags"/>
                </group>
                <footer>
                    <button string="Send" class="oe_highlight" type="object" name="action_payslip_email_send"/>
                     <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="payslip_email_wizard_action" model="ir.actions.act_window">
        <field name="name">Payslip Email Send</field>
        <field name="res_model">payslip.email.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="model_hr_payslip"/>
    </record>
</odoo>
