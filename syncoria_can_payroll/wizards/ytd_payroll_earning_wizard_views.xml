<odoo>
    <data>
        <record id="ytd_payroll_earning_wizard_form" model="ir.ui.view">
            <field name="name">ytd.payroll.earning.wizard.form</field>
            <field name="model">ytd.payroll.earning.wizard</field>
            <field name="arch" type="xml">
                <form string="YTD Payroll Earning">
                    <group>

                        <group>
                            <field name="period_type" required="1" />
                           <field name="year" invisible = "period_type == 'date_range'"/>

                            <field name="date_from" invisible = "period_type == 'year'"/>

                            <field name="date_to" invisible = "period_type == 'year'"/>
<!--                            <field name="employee_ids" required="1" widget="many2many_tags" />-->
                        </group>
                          <group>
                            <field name="payslip_state" required="1" />

                        </group>

                    </group>
                    <group>
                         <p style="color:#888888; font-style:italic;">
                                    Note: Payslips in <strong>Draft</strong> and <strong>Cancelled</strong> states are excluded from the "All" selection.
                                </p>
                    </group>
                    <footer>
                        <button string="PDF File" type="object" name="print_report" class="oe_highlight"/>
                        <button name="get_xlsx_report" string="XLSX File" type="object" class="btn-secondary"/>
                        <button string="Cancel" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>
        <record id="action_ytd_payroll_earning_wizard" model="ir.actions.act_window">
            <field name="name">YTD Payroll Earning Report</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">ytd.payroll.earning.wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>

    </data>
</odoo>