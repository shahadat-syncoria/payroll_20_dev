<odoo>
    <data>
        <record id="remittance_summary_wizard_form" model="ir.ui.view">
            <field name="name">remittance.summary.form</field>
            <field name="model">remittance.summary.wizard</field>
            <field name="arch" type="xml">
                <form string="Remittance Summary">
                    <group>
                        <group>
                            <field name="date_from" required="1"/>
                            <field name="date_to" required="1"/>
                        </group>

                    </group>
                    <footer>
                        <button string="Print" type="object" name="print_report" class="oe_highlight"/>
                        <button string="Cancel" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>
        <record id="action_remittance_summary_wizard" model="ir.actions.act_window">
            <field name="name">Remittance Summary</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">remittance.summary.wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>

    </data>
</odoo>