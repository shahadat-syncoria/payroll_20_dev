<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>
        <record id="view_hr_employee_manual_input_wiz" model="ir.ui.view">
            <field name="name">hr_employee_manual_input_wiz</field>
            <field name="model">hr.payslip.employee.manual.wizard</field>
            <field name="arch" type="xml">
                <form>
                    <group name="file_upload">

                    </group>
                    <group name="manual_input">
                        <field name="manual_input_ids"
                               groups="hr_payroll.group_hr_payroll_employee_manager"
                        >
                            <tree editable="bottom" create="0" delete="0" edit="1">


                                <field name="employee_id"/>
                                <field name="attendance_hours"/>


                            </tree>
                        </field>
                    </group>

                    <footer>
                        <button string="Generate" name="compute_sheet" type="object" class="oe_highlight" data-hotkey="q"/>
                        <button string="Cancel" class="btn btn-secondary" special="cancel" data-hotkey="z"/>
                    </footer>

                </form>
            </field>


        </record>

        <record id="action_hr_employee_manual_input_wiz" model="ir.actions.act_window">
            <field name="name">Manually Generate Payslips</field>
            <field name="res_model">hr.payslip.employee.manual.wizard</field>
            <field name="view_mode">form</field>
            <field name="view_id" ref="view_hr_employee_manual_input_wiz"/>
            <field name="target">new</field>
        </record>
    </data>
</odoo>