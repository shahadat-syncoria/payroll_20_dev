<odoo>
    <data>
        <record id="wsib_wizard_form" model="ir.ui.view">
            <field name="name">wsib.wizard.form</field>
            <field name="model">wsib.wizard</field>
            <field name="arch" type="xml">
                <form string="WSIB">
                    <group>
                        <group>
                            <field name="date_from" required="1"/>
                            <field name="date_to" required="1"/>
                        </group>
                        <group>
                            <field name="payslip_state" required="1"/>
                        </group>
                    </group>
                    <group>
                        <p style="color:#888888; font-style:italic;">
                            Note: Payslips in <strong>Draft</strong> and <strong>Cancelled</strong> states are excluded from the "All" selection.
                        </p>
                    </group>
                    <footer>
                        <button string="PDF File" type="object" name="print_report" class="oe_highlight"/>
                        <button string="Cancel" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>
        <record id="action_wsib_wizard" model="ir.actions.act_window">
            <field name="name">WSIB Report</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">wsib.wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>
    </data>
</odoo>
