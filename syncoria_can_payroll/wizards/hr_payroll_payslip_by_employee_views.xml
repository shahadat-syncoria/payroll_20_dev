<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <data>
    <record id="view_hr_payslip_by_employees_form_inherit" model="ir.ui.view">
            <field name="name">syncoria_can_payroll.hr.payslip.employees.form</field>
            <field name="model">hr.payslip.employees</field>
            <field name="inherit_id" ref="hr_payroll.view_hr_payslip_by_employees"/>
            <field name="arch" type="xml">
                <xpath expr="//span[1]" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>

<!--                Salary Structure -->
                <xpath expr="//field[@name='job_id'][1]" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
                <xpath expr="//field[@name='job_id'][2]" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
                    <xpath expr="//field[@name='employee_ids']/list/field[@name='job_id']" position="attributes">
                    <attribute name="column_invisible">1</attribute>
                </xpath>
                  <xpath expr="//field[@name='structure_type_id'][1]" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>

<!--                Department filter-->
                <xpath expr="//separator[2]" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
                <xpath expr="//div[2]" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>

                <xpath expr="//field[@name='employee_ids']" position="replace">
                    <field name="line_ids">
                        <list editable="bottom">
                            <field name="is_remove" no_label="1"/>
                            <field name="employee_id"/>
                            <field name="work_email"/>
                            <field name="department_id"/>
                            <field name="structure_type_id"/>
                        </list>
                    </field>
                </xpath>

                <xpath expr="//footer" position="inside">
                    <button name="action_select_all" type="object" string="Select All" class="btn-secondary"/>
                    <button name="action_remove" type="object" string="Remove" class="btn-danger"/>
                </xpath>
            </field>
    </record>
    <record id="hr_payroll.action_hr_payslip_by_employees" model="ir.actions.act_window">
      <field name="context">{'current_id':True}</field>
    </record>
  </data>
</odoo>