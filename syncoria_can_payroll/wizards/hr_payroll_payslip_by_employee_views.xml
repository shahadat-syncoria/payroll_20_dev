<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <data>
    <record id="view_hr_payslip_by_employees_form_inherit" model="ir.ui.view">
            <field name="name">syncoria_can_payroll.hr.payslip.employees.form</field>
            <field name="model">hr.payslip.employees</field>
            <field name="inherit_id" ref="hr_payroll.view_hr_payslip_by_employees"/>
            <field name="arch" type="xml">
                <xpath expr="//span[1]" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>

<!--                Salary Structure -->
                <xpath expr="//separator[1]" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
                <xpath expr="//div[1]" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>

<!--                Department filter-->
                <xpath expr="//separator[2]" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
                <xpath expr="//div[2]" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
            </field>
    </record>
    <record id="hr_payroll.action_hr_payslip_by_employees" model="ir.actions.act_window">
      <field name="context">{'current_id':True}</field>
    </record>
  </data>
</odoo>