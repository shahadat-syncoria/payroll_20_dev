<odoo>
    <data>
        <record id="employee_net_pay_wizard_form" model="ir.ui.view">
            <field name="name">employee.net.pay.wizard.form</field>
            <field name="model">employee.net.pay.wizard</field>
            <field name="arch" type="xml">
                <form string="Employee Net pay">
                    <group>
                        <group>

                            <field name="pay_cycle" required="1"/>
                            <field name="payperiod" required="1" domain="[('id','in',pay_cycle_period_ids_domain)]" />
                            <field name="year"/>
                            <field name="pay_cycle_period_ids_domain" invisible="1"/>
                        </group>
                        <group>
                            <field name="department_id" />
                        </group>

                    </group>
                    <footer>
                        <button string="PDF File" type="object" name="print_report" class="oe_highlight"/>
                        <button name="get_xlsx_report" string="XLSX File" type="object" class="btn-secondary"/>
                        <button string="Cancel" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>
        <record id="action_employee_net_pay_wizard" model="ir.actions.act_window">
            <field name="name">Employee Net Pay</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">employee.net.pay.wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>

    </data>
</odoo>