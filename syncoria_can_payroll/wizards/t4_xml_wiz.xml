<odoo>
    <record id="view_t4_messeage_wizard_form" model="ir.ui.view">
        <field name="name">t4.messeage.wizard.form</field>
        <field name="model">t4.messeage.wizard</field>
        <field name="arch" type="xml">
            <form string="Message">
                <group colspan="6">
                    <field name="message" readonly="1" nolabel="1" colspan="2"/>
                </group>
                <footer>
                    <button string="XML Generate" class="oe_highlight" type="object" name="action_download_t4_xml"/>
                    <button string="PDF Generate" class="oe_highlight" type="object" name="action_download_t4_pdf"/>
                     <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
