<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="fed_tax_form_view" model="ir.ui.view">
            <field name="name">syncoria_can_payroll.fed_tax.form</field>
            <field name="model">fed.tax</field>
            <field name="arch" type="xml">
                <form string="Federal Tax">
                    <sheet>
                        <group>
                            <group>
                                <field name="year"/>
                                <field name="pay_cycle"/>
                            </group>
                            <group>
                                <field name="salary_from"/>
                                <field name="salary_to" string="Salary less than"/>
                            </group>
                            <group>
                                <field name="tax_category"/>
                                <field name="tax_amount"/>
                            </group>


                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="fed_tax_list_view" model="ir.ui.view">
            <field name="name">syncoria_can_payroll.fed_tax.list</field>
            <field name="model">fed.tax</field>
            <field name="arch" type="xml">
                <list string="Federal Tax">
                    <field name="year"/>
                    <field name="pay_cycle"/>
                    <field name="salary_from"/>
                    <field name="salary_to"/>
                    <field name="tax_category"/>
                    <field name="tax_amount"/>
                </list>
            </field>
        </record>

        <record id="fed_tax_search_view" model="ir.ui.view">
            <field name="name">syncoria_can_payroll.fed_tax.search</field>
            <field name="model">fed.tax</field>
            <field name="arch" type="xml">
                <search string="Federal Tax">
                    <group>
                        <filter string="Slab Year" name="group_year" domain="[]" context="{'group_by':'year'}"/>
                        <filter string="Paycycle" name="group_pay_cycle" domain="[]" context="{'group_by':'pay_cycle'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record id="fed_tax_act_window" model="ir.actions.act_window">
            <field name="name">Federal Tax</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">fed.tax</field>
            <field name="view_mode">list,form</field>
            <field name="context">{'search_default_group_year': 1}</field>
            <field name="help" type="html">
                <p class="oe_view_nocontent_create">
                    There is no examples click here to add new Federal Tax.
                </p>
            </field>
        </record>


    </data>
</odoo>