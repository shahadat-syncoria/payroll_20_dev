<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="view_company_payroll_form" model="ir.ui.view">
            <field name="name">res.company.payroll.form</field>
            <field name="model">res.company</field>
             <field name="inherit_id" ref="base.view_company_form"/>
            <field name="arch" type="xml">
                   <xpath expr="//page[@name='branches']" position="after">
                       <page string="Payroll Information">
                           <group>
                                <field name="payroll_account_number"/>
                                <field name="employer_payroll_ref"/>
                                <field name="wsib"/>
                           </group>
                       </page>

                       <page string="EHT Config">
                           <group>
                                <field name="is_exemption"/>
                                <field name="exemption_amount" readonly="is_exemption" force_save="1"/>
                           </group>

                       </page>
                </xpath>
            </field>
        </record>

    </data>
</odoo>
