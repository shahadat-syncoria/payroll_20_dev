                                         </group>
                                     </group>
                                     <group >
                                        <group string='CPP' name="cpp">
                                            <label for="ytd_cpp_erp" class="oe_inline"/>
                                            <div class="o_row">
                                                <field name="ytd_cpp_erp"/>
                                                <button name="update_ytd_erp" type="object"
                                                        help="Update ERP CPP" context="{'type':'CPP'}" icon="fa-refresh"/>
                                            </div>
                                            <field name="ytd_previous_cpp"/>
                                            <field name="ytd_cpp"/>
                                        </group>

                                         <group string='CPP2' name="cpp2">
