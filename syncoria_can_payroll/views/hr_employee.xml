<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_employee_form_sync_can_view" model="ir.ui.view">
            <field name="model">hr.employee</field>
            <field name="inherit_id" ref="hr.view_employee_form"/>
            <field name="arch" type="xml">
                <field name="identification_id" position="attributes">
                    <attribute name="string">Employee Social Insurance Number (SIN)</attribute>
                </field>
                <xpath expr="//notebook" position="inside">
                    <page name="sync_payroll_info" string="Payroll Information" groups="hr.group_hr_manager">
                                <group>
                                    <group string='CPP' name="cpp">
                                        <group>
                                            <field name="ytd_cpp_erp"/>
                                            <field name="ytd_previous_cpp"/>
                                            <field name="ytd_cpp"/>
                                        </group>
                                        <group>
                                            <button name="update_ytd_erp" type="object"
                                                    help="Update ERP CPP" title="Update ERP CPP" context="{'type':'CPP'}" icon="fa-refresh"/>

                                        </group>


                                    </group>
                                    <group string='CPP2' name="cpp2">
                                        <group>
                                            <field name="ytd_cpp2_erp"/>
                                            <field name="ytd_previous_cpp2"/>
                                            <field name="ytd_cpp2"/>
                                        </group>
                                        <group>
                                            <button name="update_ytd_erp" type="object"
                                                    help="Update ERP CPP2" context="{'type':'CPP2'}" title="Update ERP CPP2" icon="fa-refresh"/>

                                        </group>


                                    </group>
                                    <group string='EI' name="ei">
                                        <group>
                                            <field name="ytd_ei_erp"/>
                                            <field name="ytd_previous_ei"/>
                                            <field name="ytd_ei"/>
                                        </group>
                                        <group>
                                            <button name="update_ytd_erp" type="object"
                                                    help="Update ERP CPP2" context="{'type':'EI'}" title="Update ERP EI" icon="fa-refresh"/>

                                        </group>


                                    </group>
                                    <group string='Employer EI ' name="ei">
                                        <group>
                                            <field name="ytd_ei_employer_erp"/>
                                            <field name="ytd_previous_ei_employer"/>
                                            <field name="ytd_ei_employer"/>
                                        </group>
                                        <group>
                                            <button name="update_ytd_erp" type="object"
                                                    help="Update ERP Employer EI" context="{'type':'EI_EMPLOYER'}" title="Update ERP Employer EI" icon="fa-refresh"/>

                                        </group>


                                    </group>
                                    <group string='PI/IE' name="pi">
                                        <group>
                                            <field name="ytd_pi_erp"/>
                                            <field name="ytd_previous_pi" />
                                            <field name="ytd_pi" />
                                        </group>
                                        <group>
                                        <button name="update_ytd_erp" type="object"
                                                    help="Update ERP YTDPI" context="{'type':'PI'}" title="Update ERP YTDPI" icon="fa-refresh"/>
                                            </group>
                                    </group>
                                    <group string='YTD Irregular Amount' name="irre">
                                           <group>
                                               <field name="ytd_previous_irre_payment"/>
                                               <field name="ytd_previous_irre_payment_erp"/>
                                               <field name="year_to_date_irregular_payment"/>
                                           </group>
                                        <group>
<!--                                            <field name="last_paycycle_gross"/>-->
                                        </group>



<!--                                        <group>-->
<!--                                            <field name="ytd_irre_fed_tax"/>-->
<!--                                            <field name="ytd_irre_fed_tax_erp" readonly="1"/>-->
<!--                                            <field name="ytd_previous_irre_fed_tax" />-->
<!--                                        </group>-->
<!--                                        <group>-->
<!--                                            <field name="ytd_irre_prov_tax"/>-->
<!--                                            <field name="ytd_irre_prov_tax_erp" readonly="1"/>-->
<!--                                            <field name="ytd_previous_irre_prov_tax" />-->
<!--                                        </group>-->
                                        <group>
                                        <button name="update_ytd_irregular_payments_tax" type="object"
                                                    help="Update ERP YTD Irr Tax"  title="Update ERP YTIRRTAX" icon="fa-refresh"/>
                                            </group>
                                            </group>




                                </group>
                            </page>
                </xpath>

                <xpath expr="//group[@name='active_group']" position="inside">
                    <field name="territory_of_employment" />
                    <field name="is_portal_user" />
                    <field name="portal_user_id" invisible="not is_portal_user"/>
                </xpath>
                <xpath expr="//group[@name='identification_group']" position="after">
                    <group string="T4 Information">
                        <field name="employee_cpp_qpp_xmpt_cd" />
                        <field name="employee_ei_xmpt_cd" />
                        <field name="empr_dntl_ben_rpt_cd" />
                        <field name="employee_empt_cd" />
                        <field name="employee_prov_pip_xmpt_cd" />

                     </group>



                </xpath>
            </field>
        </record>

        <record id="view_employee_form_payroll" model="ir.ui.view">
            <field name="model">hr.employee</field>
            <field name="inherit_id" ref="hr_payroll.payroll_hr_employee_view_form"/>
            <field name="arch" type="xml">
                <field name="registration_number" position="attributes">
                    <attribute name="invisible">1</attribute>
                </field>
                <field name="registration_number" position="after">
                    <field name="payroll_account_number" string="Payroll Account Number" readonly="1"/>
                    <field name="employee_prpp_dpsp_rgst_nbr"/>
                </field>
            </field>
        </record>

                <!--   Action for batch generate T4     -->
        <record id="action_T4_batch_gen" model="ir.actions.server">
        <field name="name">Batch Generate T4</field>
        <field name="model_id" ref="model_hr_employee"/>
        <field name="binding_model_id" ref="hr.model_hr_employee"/>
        <field name="state">code</field>
        <field name="code">
            action = model.action_statement_remuneration_wizard()
        </field>
    </record>

    </data>
</odoo>
