       <field name="name">Download Batch T4 </field>
       <field name="model_id" ref="syncoria_can_payroll.model_statement_remuneration"/>
       <field name="binding_model_id" ref="syncoria_can_payroll.model_statement_remuneration"/>
        <field name="binding_view_types">list</field>
       <field name="state">code</field>
       <field name="code">
            action = model.action_open_t4_message_wizard()
       </field>
    </record>
