<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="hr_hr_salary_rule_form_inherit" model="ir.ui.view">
            <field name="name">syncoria_can_payroll.hr_salary_rule.form</field>
            <field name="model">hr.salary.rule</field>
            <field name="inherit_id" ref="hr_payroll.hr_salary_rule_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='sequence']" position="after">
                    <field name="cat_code" invisible="1"/>
                    <field name="is_insurable_earning"/>
                    <field name="is_pensionable"/>
                    <field name="is_vacation_pay"/>
                    <field name="is_rrsp"/>
                    <field name="is_wsib"/>
                    <field name="is_eht"/>
                    <field name="is_irregular_payment"/>

                </xpath>

                <xpath expr="//notebook" position="inside">
                    <page name="t4_fields" string="Remuneration Paid (T4)">
                        <group name="empl_t4_statement_field_selection" string="T4 Statement Field Configuration">
                            <field name="selected_t4_statement_fields"
                                   string="T4 Statement Fields"
                                   widget="many2many_tags"
                                   nolabel="0"
                                   options="{'no_create': True, 'no_create_edit': True}"/>
                        </group>
                    </page>
                </xpath>
            </field>

        </record>
    </data>
</odoo>
