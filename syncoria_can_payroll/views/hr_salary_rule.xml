<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="hr_hr_salary_rule_form_inherit" model="ir.ui.view">
            <field name="name">syncoria_can_payroll.hr_salary_rule.form</field>
            <field name="model">hr.salary.rule</field>
            <field name="inherit_id" ref="hr_payroll.hr_salary_rule_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='appears_on_payslip']" position="after">
                    <field name="cat_code" invisible="1"/>
                    <field name="is_insurable_earning" invisible="cat_code not in ['GROSS','ADD_ALLOWANCE','ALW']"/>
                    <field name="is_pensionable" invisible="cat_code not in ['GROSS','ADD_ALLOWANCE','ALW']"/>
                    <field name="is_vacation_pay" invisible="cat_code not in ['GROSS','ADD_ALLOWANCE','ALW']"/>
                    <field name="is_irregular_payment" invisible="code not in ['BONUS','RETRO','COMMISSION']"/>

                </xpath>
            </field>

        </record>
    </data>
</odoo>
