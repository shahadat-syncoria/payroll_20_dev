<odoo>
    <!-- Action -->
    <record id="action_hr_payslip_ytd_opening" model="ir.actions.act_window">
        <field name="name">YTD Opening Balances</field>
        <field name="res_model">hr.payslip.ytd.opening</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Add or import previous year-to-date payroll amounts here.
            </p>
        </field>
    </record>

    <!-- Link Menu to Action -->

    <!-- List View (Parent) -->
    <record id="view_hr_payslip_ytd_opening_list" model="ir.ui.view">
        <field name="name">hr.payslip.ytd.opening.list</field>
        <field name="model">hr.payslip.ytd.opening</field>
        <field name="arch" type="xml">
            <list>
                <field name="employee_id"/>
                <field name="year"/>
                <field name="currency_id"/>
                <field name="company_id"/>
            </list>
        </field>
    </record>

    <!-- Form View (Parent with One2many lines) -->
    <record id="view_hr_payslip_ytd_opening_form" model="ir.ui.view">
        <field name="name">hr.payslip.ytd.opening.form</field>
        <field name="model">hr.payslip.ytd.opening</field>
        <field name="arch" type="xml">
            <form string="YTD Opening Balance">
                <sheet>
                    <group>
                        <field name="employee_id"/>
                        <field name="year"/>
                        <field name="version_id"/>
                        <field name="struct_id"/>
                        <field name="currency_id"/>
                        <field name="company_id"/>
                    </group>
                    <notebook>
                        <page name="YTD_Amount" string="YTD Amount">
                            <sheet>
                                <field name="ytd_opening_lines" no_label="1">
                                    <list editable="bottom">
                                        <field name="salary_rule_id" width="300px"/>
                                        <field name="opening_amount" width="300px"/>
                                    </list>
                                </field>
                            </sheet>
                        </page>
                    </notebook>

                </sheet>
            </form>
        </field>
    </record>

    <!-- List View (Child Model) -->
    <record id="view_hr_payslip_ytd_opening_line_list" model="ir.ui.view">
        <field name="name">hr.payslip.ytd.opening.line.list</field>
        <field name="model">hr.payslip.ytd.opening.line</field>
        <field name="arch" type="xml">
            <list>
                <field name="employee_opening_ytd_id"/>
                <field name="salary_rule_id"/>
                <field name="opening_amount"/>
            </list>
        </field>
    </record>

    <!-- Form View (Child Model) -->
    <record id="view_hr_payslip_ytd_opening_line_form" model="ir.ui.view">
        <field name="name">hr.payslip.ytd.opening.line.form</field>
        <field name="model">hr.payslip.ytd.opening.line</field>
        <field name="arch" type="xml">
            <form string="YTD Opening Line">
                <sheet>
                    <group>
                        <field name="employee_opening_ytd_id"/>
                        <field name="salary_rule_id"/>
                        <field name="opening_amount"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
