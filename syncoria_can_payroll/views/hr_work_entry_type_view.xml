<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="hr_hr_work_entry_type_form_inherit" model="ir.ui.view">
            <field name="name">syncoria_can_payroll.hr_work_entry_type.form</field>
            <field name="model">hr.work.entry.type</field>
            <field name="inherit_id" ref="hr_work_entry.hr_work_entry_type_view_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='color']" position="after">
                    <field name="is_gross" invisible="code in ['WORK100','TIMESHEET_WORK100']"/>
                    <field name="deduct_from_gross" invisible="code in ['WORK100','TIMESHEET_WORK100']"/>
                    <field name="is_insurable_hour"/>

                </xpath>

                <xpath expr="//field[@name='unpaid_structure_ids']" position="after">
                    <field name="is_negative_amount"/>

                </xpath>
            </field>

        </record>
    </data>
</odoo>
