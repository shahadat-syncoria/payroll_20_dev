<?xml version="1.0" encoding="utf-8"?>

<odoo>
    <data>

        <template id="report_payroll_earning">
            <t t-call="web.html_container">
                <!--                <t t-foreach="docs" t-as="o">-->
                <t t-call="web.external_layout">

                    <!-- <t t-call="report.external_layout"> -->
                    <div class="page">
                      <div>
                            <table class="table mt-5" name="header">
                                <tr style="text-align: left;">
                                    <th>
                                        Date Range :

                                    </th>
                                    <td>
                                        <span t-esc="date_range"/>
                                    </td>
                                </tr>


                            </table>
                            <table class="table mt-5" name="body">
                                <tr style="text-align: center;">
                                    <th name="paycycle">Pay Cycle</th>
                                    <th name="employee_name">Employee Name</th>
                                    <th name="total_gross">Total Gross</th>
                                    <th name="total_insurable_earning">Total<br/>Insurable Earnings<br/></th>
                                    <th name="net_pay">Net Pay</th>
                                    <th name="fed_tax">Federal Tax Deductions</th>
                                    <th name="prov_tax">Provincial Tax Deductions</th>
                                    <th name="cpp">CPP Deductions</th>
                                    <th name="cpp2">CPP2 Deductions</th>
                                    <th name="ei">EI Deductions</th>
                                    <th name="employer_ei">Employer EI Deductions</th>
                                     <th name="employer_contribuition">Employer Contribution</th>
                                    <th name="wsib">WSIB Premium</th>
                                </tr>

                                <t t-foreach="grouped_payslips.items()" t-as="cycle">
                                    <t t-set="pay_cycle" t-value="cycle[0]"/>
                                    <t t-set="data" t-value="cycle[1]"/>
                                    <t t-set="currency" t-value="currency"/>

                                    <tr style="font-weight: bold;">
                                        <td t-esc="pay_cycle"/>
                                    </tr>

                                    <t t-foreach="data['payslips']" t-as="line">
                                        <tr>
                                            <td name="paycycle" t-esc="line['pay_period']"/> <!-- Empty cell for alignment -->
                                            <td name="employee_name" t-esc="line['employee_name']" />
                                            <td name="total_gross">
                                                <span t-esc="round(line['total_gross'], 2)" />
                                                <span t-esc="currency" /></td>
                                            <td name="total_insurable_earnings">
                                                 <span t-esc="round(line['total_insurable_earnings'], 2)"/>
                                                <span t-esc="currency" />
                                            </td>

                                            <td name="net_pay">
                                                <span t-esc="round(line['net_pay'], 2)"/>
                                                <span t-esc="currency" />
                                            </td>

                                            <td name="fed_tax">
                                            <span t-esc="round(line['fed_tax'], 2)"/>
                                                <span t-esc="currency" />
                                            </td>
                                            <td name="prov_tax">
                                            <span t-esc="round(line['prov_tax'], 2)"/>
                                                <span t-esc="currency" />
                                            </td>
                                            <td name="cpp">
                                                <span t-esc="round(line['cpp'], 2)"/>
                                                <span t-esc="currency" />
                                            </td>

                                            <td name="cpp2">
                                            <span t-esc="round(line['cpp2'], 2)"/>
                                                <span t-esc="currency" />
                                            </td>
                                            <td name="ei"><span t-esc="round(line['ei'], 2)"/><span t-esc="currency" /></td>


                                            <td name="employer_ei"><span t-esc="round(line['employer_ei'], 2)"/><span t-esc="currency" /></td>
                                            <td name="employer_con"><span t-esc="round(line['employer_contribution'], 2)"/><span t-esc="currency" /></td>
                                            <td name="wsib"><span t-esc="round(line['wsib'], 2)"/><span t-esc="currency" /></td>
                                        </tr>
                                    </t>

                                    <!-- Totals for the current pay cycle -->

                                </t>
                                 <t t-set="line"
                                   t-value="totals"/>

                                    <tr>
                                        <td>
                                            Total:
                                        </td>
                                        <td>

                                        </td>
<!--                                        <td></td>-->
                                        <td>
                                            <span t-esc="round(line['total_gross'],2)"/>
                                            <span t-esc="currency" />
                                        </td>
                                        <td>
                                            <span t-esc="round(line['total_insurable_earnings'],2)"/>
                                            <span t-esc="currency" />
                                        </td>
                                        <td name="total_net_pay">
                                            <span t-esc="round(line['net_pay'],2)"/>
                                            <span t-esc="currency" />
                                        </td>
                                        <td name="total_fed_tax">
                                            <span t-esc="round(line['fed_tax'],2)"/>
                                            <span t-esc="currency" />
                                        </td>
                                        <td name="total_prov_tax">
                                            <span t-esc="round(line['prov_tax'],2)"/>
                                            <span t-esc="currency" />
                                        </td>
                                        <td name="total_cpp">
                                            <span t-esc="round(line['cpp'],2)"/>
                                            <span t-esc="currency" />
                                        </td>
                                        <td name="total_cpp2">
                                            <span t-esc="round(line['cpp2'],2)"/>
                                            <span t-esc="currency" />
                                        </td>
                                        <td name="total_ei">
                                            <span t-esc="round(line['ei'],2)"/>
                                            <span t-esc="currency" />
                                        </td>
                                        <td name="total_employer_ei">
                                            <span t-esc="round(line['employer_ei'],2)"/>
                                            <span t-esc="currency" />
                                        </td>
                                                <td name="total_employer_con">
                                            <span t-esc="round(line['employer_contribution'],2)"/>
                                            <span t-esc="currency" />
                                        </td>
                                        <td name="total_wsib">
                                            <span t-esc="round(line['wsib'],2)"/>
                                            <span t-esc="currency" />
                                        </td>
                                    </tr>
                            </table>


                        </div>


                    </div>
                </t>

            </t>
        </template>
    </data>

</odoo>