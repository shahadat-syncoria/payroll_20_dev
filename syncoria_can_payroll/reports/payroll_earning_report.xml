<?xml version="1.0" encoding="utf-8"?>

<odoo>
    <data>

        <template id="report_payroll_earning">
            <t t-call="web.html_container">
                <!--                <t t-foreach="docs" t-as="o">-->
                <t t-call="web.external_layout">

                    <!-- <t t-call="report.external_layout"> -->
                    <div class="page">
                        <div>
                            <table class="table" name="header">
                                <tr style="text-align: left;">
                                    <th>
                                        Date Range :

                                    </th>
                                    <td>
                                        <span t-esc="date_range"/>
                                    </td>
                                </tr>


                            </table>
                            <table class="table mt-5" name="body">
                                <tr style="text-align: center;">
                                    <th>Pay Cycle</th>
                                    <th>Employee Name</th>
                                    <th>Total Gross</th>
                                    <th>Total Insurable Earnings</th>
                                    <th>Net Pay</th>
                                    <th>Federal Tax Deductions</th>
                                    <th>Provincial Tax Deductions</th>
                                    <th>CPP Deductions</th>
                                    <th>CPP2 Deductions</th>
                                    <th>EI Deductions</th>
                                    <th>Employer EI Deductions</th>
                                </tr>

                                <t t-foreach="grouped_payslips.items()" t-as="cycle">
                                    <t t-set="pay_cycle" t-value="cycle[0]"/>
                                    <t t-set="data" t-value="cycle[1]"/>

                                    <tr style="font-weight: bold;">
                                        <td t-esc="pay_cycle"/>
                                    </tr>

                                    <t t-foreach="data['payslips']" t-as="line">
                                        <tr>
                                            <td t-esc="line['pay_period']"/> <!-- Empty cell for alignment -->
                                            <td t-esc="line['employee_name']"/>
                                            <td t-esc="round(line['total_gross'], 2)"/>
                                            <td t-esc="round(line['total_insurable_earnings'], 2)"/>
                                            <td t-esc="round(line['net_pay'], 2)"/>
                                            <td t-esc="round(line['fed_tax'], 2)"/>
                                            <td t-esc="round(line['prov_tax'], 2)"/>
                                            <td t-esc="round(line['cpp'], 2)"/>
                                            <td t-esc="round(line['cpp2'], 2)"/>
                                            <td t-esc="round(line['ei'], 2)"/>
                                            <td t-esc="round(line['employer_ei'], 2)"/>
                                        </tr>
                                    </t>

                                    <!-- Totals for the current pay cycle -->

                                </t>
                                 <t t-set="line"
                                   t-value="totals"/>

                                    <tr>
                                        <td>
                                            Total:
                                        </td>
                                        <td>

                                        </td>
                                        <td>
                                            <span t-esc="round(line['total_gross'],2)"/>
                                        </td>
                                        <td>
                                            <span t-esc="round(line['total_insurable_earnings'],2)"/>
                                        </td>
                                        <td>
                                            <span t-esc="round(line['net_pay'],2)"/>
                                        </td>
                                        <td>
                                            <span t-esc="round(line['fed_tax'],2)"/>
                                        </td>
                                        <td>
                                            <span t-esc="round(line['prov_tax'],2)"/>
                                        </td>
                                        <td>
                                            <span t-esc="round(line['cpp'],2)"/>
                                        </td>
                                        <td>
                                            <span t-esc="round(line['cpp2'],2)"/>
                                        </td>
                                        <td>
                                            <span t-esc="round(line['ei'],2)"/>
                                        </td>
                                        <td>
                                            <span t-esc="round(line['employer_ei'],2)"/>
                                        </td>
                                    </tr>
                            </table>


                        </div>


                    </div>
                </t>

            </t>
        </template>
    </data>

</odoo>