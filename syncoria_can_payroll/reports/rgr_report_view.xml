<?xml version="1.0" encoding="utf-8"?>

<odoo>
    <data>

        <template id="report_rgr">
            <t t-call="web.html_container">
                    <t t-call="web.external_layout">

                        <!-- <t t-call="report.external_layout"> -->
                        <div class="page">
                            <div class="text-center">
                                <span t-esc="company_name"/> Receiver General<br/>

                                Paygroup:  <span t-esc="paygroup"/><br/>
                                Pay Cycle Ending: <span t-esc="datetime.datetime.strptime(date_to, '%Y-%m-%d').strftime('%b %d %Y')"/><br/>
                                Report Ran: <span t-esc="context_timestamp(datetime.datetime.now()).strftime('%b %d %Y %I:%M %p')"/>

                            </div>
<!--                            <style>-->
<!--                                td {-->
<!--                                border-right:none !important;-->
<!--                                }-->
<!--                            </style>-->
                              <table class="table  mt-2"  name="body">
                                  <tbody>
                                        <tr class="text-center" style="border:none;">
                                        <td><b>Tax Type</b></td>
                                        <td><b>EMPLOYEE</b></td>
                                        <td><b>EMPLOYER</b></td>
                                        <td><b>Total</b></td>
                                    </tr>
                                      <t t-set="sum_total" t-value="0.0"/>
                                      <t t-set="sum_total_deduction_employee" t-value="0.0"/>
                                      <t t-set="sum_total_deduction_employer" t-value="0.0"/>
                                      <tr>
                                          <td class="text-left">
                                              Income Tax
                                          </td>
                                          <td class="text-center">
                                               <span t-esc="currency_id"/><span t-esc="round(payslips.get('total_income_tax',0.0),2)"/>
                                          </td>
                                          <td class="text-center">

                                          </td>
                                          <td class="text-center">
                                              <span t-esc="currency_id"/><span t-esc="round(payslips.get('total_income_tax',0.0),2)"/>
                                          </td>
                                          <t t-set="sum_total" t-value="sum_total+payslips.get('total_income_tax',0.0)"/>
                                          <t t-set="sum_total_deduction_employee" t-value="sum_total_deduction_employee+payslips.get('total_income_tax',0.0)"/>


                                      </tr>
                                      <tr >
                                          <td class="text-left">
                                              CPP
                                          </td>
                                          <td class="text-center">
                                              <span t-esc="currency_id"/><span t-esc="round(payslips.get('total_cpp_employee',0.0),2)"/>
                                          </td>
                                          <td class="text-center">
                                              <span t-esc="currency_id"/><span t-esc="round(payslips.get('total_cpp_employer',0.0),2)"/>
                                          </td>
                                          <td class="text-center">
                                               <span t-esc="currency_id"/><span t-esc="round(payslips.get('total_cpp_employee',0.0)+payslips.get('total_cpp_employer',0.0),2)"/>
                                          </td>
                                          <t t-set="sum_total" t-value="sum_total+payslips.get('total_cpp_employee',0.0)+payslips.get('total_cpp_employer',0.0)"/>
                                          <t t-set="sum_total_deduction_employee" t-value="sum_total_deduction_employee+payslips.get('total_cpp_employee',0.0)"/>
                                          <t t-set="sum_total_deduction_employer" t-value="sum_total_deduction_employer+payslips.get('total_cpp_employer',0.0)"/>

                                      </tr>
                                      <tr >
                                          <td class="text-left">
                                             EI
                                          </td>
                                          <td class="text-center">
                                              <span t-esc="currency_id"/><span t-esc="round(payslips.get('total_ei_employee',0.0),2)"/>
                                          </td>
                                          <td class="text-center">
                                              <span t-esc="currency_id"/><span t-esc="round(payslips.get('total_ei_employer',0.0),2)"/>
                                          </td>
                                          <td class="text-center">
                                              <span t-esc="currency_id"/><span t-esc="round(payslips.get('total_ei_employee',0.0)+payslips.get('total_ei_employer',0.0),2)"/>

                                          </td>
                                          <t t-set="sum_total" t-value="sum_total+payslips.get('total_ei_employee',0.0)+payslips.get('total_ei_employer',0.0)"/>
                                          <t t-set="sum_total_deduction_employee" t-value="sum_total_deduction_employee+payslips.get('total_ei_employee',0.0)"/>
                                          <t t-set="sum_total_deduction_employer" t-value="sum_total_deduction_employer+payslips.get('total_ei_employer',0.0)"/>

                                      </tr>
                                      <tr >
                                          <td class="text-left">
                                              PPIP
                                          </td>
                                          <td class="text-center">

                                          </td>
                                          <td class="text-center">

                                          </td>
                                          <td class="text-center">
                                              <span t-esc="currency_id"/>0.0
                                          </td>

                                      </tr>
                                      <tr >
                                          <td class="text-left">
                                              EHT/HSF
                                          </td>
                                          <td class="text-center">

                                          </td>
                                          <td class="text-center">

                                          </td>
                                          <td class="text-center">
                                              <span t-esc="currency_id"/>0.0
                                          </td>

                                      </tr>
                                      <tr >
                                          <td class="text-left">
                                              Total Remit
                                          </td>
                                          <td class="text-center">

                                          </td>
                                          <td class="text-center">

                                          </td>
                                          <td class="text-center">
                                              <u>
                                                  <span t-esc="currency_id"/><b><span t-esc="round(sum_total,2)"/></b>
                                              </u>


                                          </td>

                                      </tr>
                                      <tr >
                                          <td class="text-left">
                                              Employees Paid
                                          </td>
                                          <td class="text-center">
                                              <u>
                                                  <b><span t-esc="payslips.get('total_employee_paid')"/></b>
                                              </u>

                                          </td>
                                          <td class="text-center">

                                          </td>
                                          <td class="text-center">

                                          </td>

                                      </tr>
                                      <tr >
                                          <td class="text-left">
                                              Gross Payroll
                                          </td>
                                          <td class="text-center">
                                              <u>
                                                  <span t-esc="currency_id"/><b><span t-esc="payslips.get('total_gross',0.0)"/></b>
                                              </u>
                                          </td>
                                          <td class="text-center">

                                          </td>
                                          <td class="text-right">

                                          </td>

                                      </tr>
                                      <tr >
                                          <td class="text-left">
                                              CRA Number
                                          </td>
                                          <td class="text-center">
                                              <span t-esc="payslips.get('cra_number')"/>

                                          </td>
                                          <td class="text-center">

                                          </td>
                                          <td class="text-center">

                                          </td>

                                      </tr>
                                      <tr >
                                          <th class="text-center">
                                                    Deductions
                                          </th>
                                          <th class="text-center">
                                              EMPLOYEE
                                          </th>
                                          <th class="text-center">
                                              EMPLOYER
                                          </th>
                                          <th class="text-center">
                                              TOTAL
                                          </th>

                                      </tr>
                                      <tr >
                                          <td class="text-left">
                                              TOTALS
                                          </td>
                                          <td class="text-center">
                                              <span t-esc="currency_id"/><span t-esc="round(sum_total_deduction_employee,2)"/>
                                          </td>
                                          <td class="text-center">
                                              <span t-esc="currency_id"/><span t-esc="round(sum_total_deduction_employer,2)"/>
                                          </td>
                                          <td class="text-center">
                                              <span t-esc="currency_id"/><span t-esc="round(sum_total_deduction_employee+sum_total_deduction_employer,2)"/>
                                          </td>

                                      </tr>







                                  </tbody>
                            </table>
                        </div>
                    </t>
                </t>

        </template>
    </data>

</odoo>



