<?xml version="1.0" encoding="utf-8"?>

<odoo>
    <data>

        <template id="report_roe_earning_per_employee">
            <t t-call="web.html_container">
                <!--                <t t-foreach="docs" t-as="o">-->
                <t t-call="web.external_layout">

                    <!-- <t t-call="report.external_layout"> -->
                    <div class="page">
                        <div style="margin:0 6rem 0 6rem">
                            <table class="table" name="header">
                                <tr style="text-align: left;">
                                    <th>
                                        Payroll History -
                                        <span t-out="employee_name"/>
                                    </th>

                                </tr>
                                <tr style="text-align: left;">
                                    <th>
                                        Hire Date:
                                        <span t-out="hire_date"/>
                                        - Term Date:
                                        <span t-out="term_date"/>
                                    </th>

                                </tr>
                                <tr style="text-align: left;">
                                    <th>
                                        Paygroup: <span t-out="paygroup"/>
                                    </th>

                                </tr>
                            </table>
                            <table class="table mt-5" name="body">
                                <tr style="text-align: center;">
                                    <th>
                                        Pay #
                                    </th>
                                    <th>
                                        Pay Cycle
                                    </th>
                                    <th>
                                        Hours
                                    </th>
                                    <th>
                                        Gross Amount
                                    </th>
                                    <th>
                                        Details
                                    </th>
                                    <th>
                                    </th>
<!--                                    <th>-->
<!--                                        Off-cycle-->
<!--                                    </th>-->

                                </tr>
                                <t t-set="lines"
                                   t-value="payslips"/>
                                <t t-foreach="lines" t-as="line">

                                    <tr>
                                    <td>
                                        <span t-out="line['pay']"/>
                                    </td>
                                    <td>
                                        <span t-out="line['paycycle_date_from']"/>-
                                        <span t-out="line['paycycle_date_to']"/>

                                    </td>
                                    <td>
                                        <span t-out="round(line['hours'],2)"/>
                                    </td>
                                    <td>
                                        <span t-out="currency_id" /> <span t-out="round(line['Gross'],2)"/>
                                    </td>
                                    <td>
                                        <span t-out="line['details']"/>
                                    </td>
                                    <td>
                                        <t t-set="start" t-value="false"/>
                                         <t t-foreach="line['gross_details']" t-as="gross">
                                             <span t-out="currency_id" /> <span t-out="gross['total']" /><br/>
<!--                                             <t t-if="start == false">-->
<!--                                                 <span t-out="gross['total']"/>-->
<!--                                             </t>-->
<!--                                             <t t-else="">-->
<!--                                                 <span t-out="gross['total']"/><br/>-->
<!--                                             </t>-->
<!--                                             <t t-set="start" t-value="true"/>-->
                                         </t>

                                    </td>
<!--                                    <td></td>-->
                                </tr>
                                </t>
                            </table>

                            <div>
                                <span t-out="round(total_hours,2)"/> hrs to: <span t-out="round(total_hours)"/>
                            </div>

                        </div>

                        <!--
                        Build your report here!
                        Do it in awesome way ;)
                        -->
                    </div>
                </t>
                <!--                </t>-->
            </t>
        </template>
    </data>

</odoo>



