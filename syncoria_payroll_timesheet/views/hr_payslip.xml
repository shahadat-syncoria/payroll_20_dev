<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_payslip_form_inherit_timesheet_button" model="ir.ui.view">
    <field name="name">hr.payslip.form.timesheet.button</field>
    <field name="model">hr.payslip</field>
    <field name="inherit_id" ref="hr_payroll.view_hr_payslip_form"/>
    <field name="arch" type="xml">
        <!-- Insert inside the button box -->
        <div name="button_box" position="inside">
            <button name="action_open_employee_timesheets"
                    type="object"
                    class="oe_stat_button"
                    icon="schedule"
                    invisible="not employee_id" >
                <field name="timesheet_count" widget="statinfo" string="Timesheets"/>
            </button>
        </div>
    </field>
</record>
</odoo>

