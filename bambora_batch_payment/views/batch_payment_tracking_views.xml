<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>

        <record id="batch_payment_form" model="ir.ui.view">
            <field name="name">batch.payment.form</field>
            <field name="model">batch.payment.tracking</field>
            <field name="arch" type="xml">
                <form create="0" edit="0" delete="0">
                    <sheet>
                        <group>
                            <group>
                                <field name="batch_id" />
                                <field name="transaction_id" />
                                <field name="transaction_date" />
                                <field name="invoice_no" />
                                <field name="invoice_ref" />

                                <field name="is_payslip" />
                                <field name="payslip_no" />
                                <field name="payslip_ref" />

                                <field name="invoice_partner_id" />
                                <field name="employee_id" />
                                <field name="partner_bank_id" />
                                <field name="invoice_date" />
                                <field name="settlement_date" />
                                <field name="state" />
                                <field name="status" />
                                <field name="remain_settle_day" />
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="batch_payment_tree" model="ir.ui.view">
            <field name="name">batch.payment.list</field>
            <field name="model">batch.payment.tracking</field>
            <field name="arch" type="xml">
                <list create="0" edit="0" delete="0">
                    <field name="batch_id" />
                    <field name="transaction_id" />
                    <field name="transaction_date" />
                    <field name="invoice_no" />
                    <field name="invoice_ref" />
                    <field name="invoice_partner_id" />
                    <field name="partner_bank_id" />
                    <field name="invoice_date" />
                    <field name="state" />
                    <field name="status" />
                    <field name="remain_settle_day" />
                </list>
            </field>
        </record>

        <record id="action_batch_payment" model="ir.actions.act_window">
            <field name="name">Bambora Batch Payments</field>
            <field name="res_model">batch.payment.tracking</field>
            <field name="view_mode">list,form</field>
            <!-- <field name="search_view_id" ref="view_account_type_search"/> -->
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                Batch Payments from Bambora are tracked here
                </p>
                <p>
                </p>
            </field>
        </record>

        <menuitem
      id="batch_payment_configuration_menu"
      action="action_batch_payment"
      parent="account.menu_finance_payables"
      sequence="30"
    />

        <menuitem
                id="menu_hr_salary_bambora_batch_payment"
                name="Bambora Payments"
                parent="hr_work_entry_contract_enterprise.menu_hr_payroll_configuration"
                sequence="100"
                groups="hr_payroll.group_hr_payroll_manager"
        />
        <menuitem
      id="batch_payment_configuration_menu"
      action="action_batch_payment"
      parent="menu_hr_salary_bambora_batch_payment"
      sequence="10"
    />

    </data>
</odoo>
