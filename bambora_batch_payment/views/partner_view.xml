<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>

        <record id="view_partner_bamboraeft" model="ir.ui.view">
            <field name="name">res.partner.bamboraeft.inherit</field>
            <field name="model">res.partner</field>
            <field name="inherit_id" ref="account.view_partner_property_form" />
            <field name="arch" type="xml">
                <xpath expr="//field[@name='bank_ids']" position="replace">
                    <field name="bank_ids" nolabel="1">
                        <tree editable="bottom">
                            <field name="sequence" widget="handle" />
                            <field name="bank_id" />
                            <field name="acc_number" />
                            <field name="acc_holder_name" invisible="1" />
                            <field name="bank_bic" />
                            <field name="bank_transit_no" />
                            <field name="bank_account_type" />
                            <!-- <field name="bamboraeft_customer_code"/> -->
                        </tree>
                    </field>
                </xpath>
            </field>
        </record>

        <record id="view_partners_form_payment_bamboraeft" model="ir.ui.view">
            <field name="name">view.res.partner.form.payment.bamboraeft</field>
            <field name="model">res.partner</field>
            <field name="inherit_id" ref="base.view_partner_form" />
            <field name="priority" eval="15" />
            <field name="arch" type="xml">
                <div name="button_box" position="inside">
                    <button
            type="action"
            class="oe_stat_button"
            icon="fa-bank"
            name="%(payment.action_payment_token)d"
            context="{'search_default_partner_id': active_id, 'create': False, 'edit': False}"
            attrs="{'invisible': [('payment_eft_count', '=', 0)]}"
          >
                        <div class="o_form_field o_stat_info">
                            <span class="o_stat_value">
                                <field
                  name="payment_eft_count"
                  widget="statinfo"
                  nolabel="1"
                />
                            </span>
                            <span class="o_stat_text">EFT</span>
                        </div>
                    </button>
                </div>
            </field>
        </record>

        <record id="view_partner_bank_form_inherited" model="ir.ui.view">
            <field name="name">view.res.partner.bank.form.bamboraeft</field>
            <field name="model">res.partner.bank</field>
            <field name="inherit_id" ref="base.view_partner_bank_form" />
            <field name="arch" type="xml">
                <xpath expr="//form//sheet" position="before">
                    <header>
                        <button
              string="Create Bambora Profile"
              type="object"
              name="action_create_bamboraeft_token"
              class="btn btn-primary"
              attrs="{ 'invisible' : [('bamboraeft_status','=',False)] }"
            />
                    </header>
                </xpath>
                <xpath expr="//field[@name='acc_number']" position="after">
                    <field name="bank_transit_no" />
                    <field name="bank_account_type" />
                </xpath>
                <xpath expr="//field[@name='acc_holder_name']" position="after">
                    <field
            name="payment_token_id"
            domain="[('partner_id','=',partner_id)]"
          />
                    <field name="bamboraeft_status" invisible="1" />
                </xpath>
            </field>
        </record>

    </data>
</odoo>
