<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_partner_bamboraeft" model="ir.ui.view">
            <field name="name">res.partner.bamboraeft.inherit</field>
            <field name="model">res.partner</field>
            <field name="inherit_id" ref="account.view_partner_property_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='bank_ids']" position="replace">
                    <field name="bank_ids" nolabel="1">
                        <tree editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="bank_id"/>
                            <field name="acc_number"/>
                            <field invisible="1" name="acc_holder_name"/>
                            <field name="bank_bic"/>
                            <field name="bank_transit_no"/>
                            <field name="bank_account_type"/>
                            <!-- <field name="bamboraeft_customer_code"/> -->
                        </tree></field>
                </xpath></field>
        </record>
        <record id="view_partners_form_payment_bamboraeft" model="ir.ui.view">
            <field name="name">view.res.partner.form.payment.bamboraeft</field>
            <field name="model">res.partner</field>
            <field name="inherit_id" ref="base.view_partner_form"/>
            <field eval="15" name="priority"/>
            <field name="arch" type="xml">
                <div name="button_box" position="inside">
                    <button class="oe_stat_button" context="{'search_default_partner_id': active_id, 'create': False, 'edit': False}" icon="fa-bank" invisible="payment_eft_count == 0" name="%(payment.action_payment_token)d" type="action">
                        <div class="o_form_field o_stat_info">
                            <span class="o_stat_value">
                                <field name="payment_eft_count" nolabel="1" widget="statinfo"/>
                            </span>
                            <span class="o_stat_text">
                                EFT
                            </span>
                        </div>
                    </button>
                </div></field>
        </record>
        <record id="view_partner_bank_form_inherited" model="ir.ui.view">
            <field name="name">view.res.partner.bank.form.bamboraeft</field>
            <field name="model">res.partner.bank</field>
            <field name="inherit_id" ref="base.view_partner_bank_form"/>
            <field name="arch" type="xml">
                <xpath expr="//form//sheet" position="before">
                    <header>
                        <button class="btn btn-primary" invisible="bamboraeft_status == False" name="action_create_bamboraeft_token" string="Create Bambora Profile" type="object"/>
                    </header>
                </xpath>
                <xpath expr="//field[@name='acc_number']" position="after">
                    <field name="bank_transit_no"/>
                    <field name="bank_account_type"/>
                </xpath>
                <xpath expr="//field[@name='acc_holder_name']" position="after">
                    <field domain="[('partner_id','=',partner_id)]" name="payment_token_id"/>
                    <field invisible="1" name="bamboraeft_status"/>
                </xpath></field>
        </record>
    </data>
</odoo>
