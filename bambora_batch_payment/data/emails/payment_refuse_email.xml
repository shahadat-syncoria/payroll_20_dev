<odoo>
    <data noupdate="0">
        <record id="email_template_payroll_bambora_refuse" model="mail.template">
            <field name="name">Bambora Payment Refuse template</field>
            <field name="model_id" ref="hr_payroll.model_hr_payslip"/>
            <field name="subject">Bambora Payment Reject</field>
            <field name="email_from">{{ object.company_id.email }}</field>
<!--            <field name="email_to">jahin@syncoria.com,ador.jahin29@gmail.com,</field>-->
            <field name="body_html" type="html">
                <div style="margin: 0px; padding: 0px;">
                    <p style="margin: 0px; padding: 10px; font-size: 13px;">
                 Greetings ,<br></br>
                        We regret to inform you that the Bambora transaction (Batch no: <span style="font-weight:bold;" t-out="object.bambora_batch_payment_id.batch_id or ''">10001</span> and Transaction no: <span style="font-weight:bold;" t-out="object.bambora_batch_payment_id.transaction_id or ''">1</span>) for <span style="font-weight:bold;" t-out="object.name or ''">Jan-1</span>, intended for Employee <span style="font-weight:bold;" t-out="object.employee_id.name or ''">Hannah</span>, has unfortunately failed. We kindly request that you take the necessary steps to address this issue promptly.


If you require any further assistance or information, please do not hesitate to reach out.

          <br></br>
                    Regards<br></br>
                    Administration

                    </p>
                </div>
            </field>
        </record>
    </data>
</odoo>