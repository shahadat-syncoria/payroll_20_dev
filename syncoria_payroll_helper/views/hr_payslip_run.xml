<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="hr_payslip_run_form_payroll_helper" model="ir.ui.view">
            <field name="name">syncoria_payroll_helper.hr_payslip_run.form</field>
            <field name="model">hr.payslip.run</field>
            <field name="inherit_id" ref="hr_payroll.hr_payslip_run_form"/>
            <field name="arch" type="xml">
                <xpath expr="//button[@name='action_validate']" position="before">
                    <field invisible="1" name="is_manual_input"/>
                    <button class="oe_highlight" invisible="is_manual_input == False or state != 'draft' or state not in ['draft']" name="%(syncoria_can_payroll.action_hr_employee_manual_input_wiz)d" string="Manually Generate Payslips" type="action"/>
                </xpath>
                <xpath expr="//button[@name='%(hr_payroll.action_hr_payslip_by_employees)d']" position="attributes">
                    <attribute name="invisible">1 or state not in ['False']</attribute>
                </xpath></field>
        </record>
    </data>
</odoo>
