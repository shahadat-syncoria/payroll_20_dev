<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="hr_payslip_run_form_payroll_helper" model="ir.ui.view">
            <field name="name">syncoria_payroll_helper.hr_payslip_run.form</field>
            <field name="model">hr.payslip.run</field>
            <field name="inherit_id" ref="hr_payroll.hr_payslip_run_form"/>
            <field name="arch" type="xml">
                <xpath expr="//button[@name='action_validate']" position="before">
                    <field name="is_manual_input" invisible="1"/>
                    <button name="%(syncoria_can_payroll.action_hr_employee_manual_input_wiz)d" type="action"
                            string="Manually Generate Payslips" class="oe_highlight" states="draft"
                            attrs="{'invisible': ['|',('is_manual_input','=',False),('state','!=','draft')]}"/>
                </xpath>
                <xpath expr="//button[@name='%(hr_payroll.action_hr_payslip_by_employees)d']" position="attributes">
                    <attribute name="invisible">1</attribute>
                    <attribute name="states">False</attribute>
                </xpath>
            </field>
        </record>
    </data>
</odoo>