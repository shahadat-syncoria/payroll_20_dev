<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_partner_form_inherit_rbc" model="ir.ui.view">
        <field name="name">res.partner.form.inherit.rbc</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="syncoria_can_payroll.view_partner_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='cntc_extn_nbr']" position="after">
                <field name="rbc_client_number" placeholder="Enter RBC Client Number" />
            </xpath>
        </field>
    </record>

    <record id="view_partner_bank_form_rbc" model="ir.ui.view">
            <field name="name">view.res.partner.bank.form.rbc</field>
            <field name="model">res.partner.bank</field>
            <field name="inherit_id" ref="base.view_partner_bank_form"/>
            <field name="arch" type="xml">

                <xpath expr="//field[@name='account_number']" position="after">
                    <field name="rbc_bank_transit_no"/>

                </xpath>
                </field>
        </record>
</odoo>
