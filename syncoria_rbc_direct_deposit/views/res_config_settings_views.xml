<?xml version="1.0" encoding="utf-8"?>

<odoo>
    <record id="res_config_settings_view_form_public_holiday" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.weekly.hour.cap</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="hr_payroll.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='hr_payroll_settings']" position="after">
                <block title="RBC Direct Deposit" id="rbc_direct_deposit">
                <setting
                    name="production"
                    string="Production"
                    help="Enable this option if the environment is production">
                    <field name="production"/>
                </setting>

                </block>
            </xpath>

        </field>
    </record>
</odoo>


