<odoo>
    <data>
        <record id="hr_payslip_run_form_rbc" model="ir.ui.view">
            <field name="name">syncoria_rbc_direct_deposit.hr_payslip_run.form</field>
            <field name="model">hr.payslip.run</field>
            <field name="inherit_id" ref="hr_payroll.hr_payslip_run_form"/>
            <field name="arch" type="xml">


                <xpath expr="//field[@name='company_id']" position="after">
                        <field name="direct_deposit_txt_filename" invisible="1"/>
                       <field name="direct_deposit_txt" filename="direct_deposit_txt_filename" />

                </xpath>
            <xpath expr="//button[@name='action_draft']" position="after">
                <button string="Create Direct Deposit File" name="action_txt_report" type="object" invisible="state != 'paid'"/>
             </xpath>
            </field>

        </record>


