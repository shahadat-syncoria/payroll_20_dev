<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <template id="report_remittance_summary_wsco" inherit_id="syncoria_can_payroll.report_remittance_summary">
     <xpath expr="//div[@id='remittance_summery_content']" position="replace">
         <div id="remittance_summery_content_wsco" style="margin:0 6rem 0 6rem">
              <h4>Deduction &amp; Expenses Summary <span t-esc="date_range"/> </h4>
                            <table class="table table-sm table-borderless" name="body">
                                <tr>
                                    <th>
                                        <b> Deduction &amp; Expenses</b>
                                    </th>

                                    <th style="text-align:right">
                                        <b>Amount</b>
                                    </th>
                                    <th style="text-align:right">
                                        <b>No. Of Employees</b>
                                    </th>
                                </tr>

                                <t t-set="lines"
                                   t-value="payslips"/>

                                <t t-foreach="lines" t-as="line">
<!--                                    <t t-set="sum_total_gross" t-value="sum_total_gross+float(line['total_gross'])"/>-->

                                    <tr>
                                        <td style="text-align:left">
                                            <span>CPP</span>
                                        </td>
                                        <td style="text-align:right">
                                            <span t-esc="line['total_cpp']"/>
                                        </td>
                                        <td style="text-align:right">
                                            <span t-esc="0 if line['total_cpp'] == 0 else line['employees_paid']"/>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td style="text-align:left">
                                            <span>CPP2</span>
                                        </td>
                                        <td style="text-align:right">
                                            <span t-esc="line['total_cpp2']"/>
                                        </td>
                                        <td style="text-align:right">
                                           <span t-esc="0 if line['total_cpp2'] == 0 else line['employees_paid']"/>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td style="text-align:left">
                                            <span>EI</span>
                                        </td>
                                        <td style="text-align:right">
                                            <span t-esc="line['total_ei']"/>
                                        </td>
                                        <td style="text-align:right">
                                            <span t-esc="0 if line['total_ei'] == 0 else line['employees_paid']"/>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td style="text-align:left">
                                            <span>Federal Tax</span>
                                        </td>
                                        <td style="text-align:right">
                                            <span t-esc="line['total_ftax']"/>
                                        </td>
                                        <td style="text-align:right">
                                            <span t-esc="0 if line['total_ftax'] == 0 else line['employees_paid']"/>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td style="text-align:left">
                                            <span>Provincial Tax</span>
                                        </td>
                                        <td style="text-align:right">
                                            <span t-esc="line['total_otax']"/>
                                        </td>
                                        <td style="text-align:right">
                                            <span t-esc="0 if line['total_otax'] == 0 else line['employees_paid']"/>
                                        </td>
                                    </tr>
                                </t>
                            </table>

                        </div>


        </xpath>

    </template>
</odoo>