<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <template id="report_payslip_wsco" inherit_id="hr_payroll.report_payslip">

        <xpath expr="//div[@id='computed_on']" position="replace">
                <div id="paid_date">
                                    <strong class="me-2">Pay Date:</strong>
                                    <span t-field="o.paid_date"/>
                                </div>

        </xpath>

         <xpath expr="//div/table/thead/tr/th[@id='line_header_total']" position="after">
             <th id="line_header_ytd_total" class="text-end">YTD Total</th>
        </xpath>
         <xpath expr="//div/table/tbody/span/tr/td[@id='payslip_line_ytd']" position="after">
             <td id="payslip_ytd" class="text-end">

                <span t-esc="o._payslip_line_ytd_total().get(line.code, 0)"
              t-options="{'widget': 'monetary', 'display_currency': o.company_id.currency_id}"
              t-att-style="'color:#875A7B;' if o._payslip_line_ytd_total().get(line.code, 0) &lt; 0 else ''"/>
             </td>
        </xpath>
    </template>
</odoo>

