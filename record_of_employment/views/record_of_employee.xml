<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_record_of_employee_form" model="ir.ui.view">
        <field name="name">record.of.employee.form</field>
        <field name="model">record.of.employee</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="state" widget="statusbar"/>
                    <button class="btn btn-primary" invisible="state != 'done'" name="download_roe_pdf" string="ROE Slip Download" type="object"/>
                    <button class="btn btn-primary" invisible="state != 'done'" name="download_roe_xml" string="ROE XML Download" type="object"/>
                    <button class="btn btn-primary" invisible="state in ['done']" name="compute_roe" string="Compute" type="object"/>
                    <button name="action_mark_done" string="Mark as Done" type="object" class="btn btn-secondary" invisible="state == 'done'"/>
                    <button name="action_cancel" string="Cancel" type="object" class="btn btn-secondary" invisible="state == 'cancel'"/>
                </header>
                <sheet>
                    <div name="button_box">
                        <button class="oe_stat_button" icon="fa-upload" name="open_roe_website" type="object">
                            Upload ROE
                        </button>
                    </div>
                    <group readonly="state != 'draft'">

                        <group string="Employee Information">

                            <field name="employee_id"/>
                            <field name="company_id"/>
                            <field name="occupation"/>
                             <field name="employee_lnm" />
                                <field name="employee_fnm"/>
                                <field name="employee_init" />


                        </group>
                        <group string="Employer Information">
                            <field name="company_id"/>
                            <field name="name_of_issuer_id"/>
                            <field name="telephone_no"/>
                            <field name="area_code"/>
                            <field name="ext_no"/>
                            <field name="employer_payroll_ref"/>
                            <field name="language"/>
                        </group>

                            <group name="empl_info_add">
                                <field name="employee_addr_l1_txt" />
                                <field name="employee_addr_l2_txt" />
                                <field name="employee_cty_nm" />
                                <field name="employee_prov_cd" />
                                <field name="employee_cntry_cd"/>
                                <field name="employee_pstl_cd" />
                            </group>
                        <group string="Serial and Payroll Information">
                            <field name="serial_no"/>
                            <field name="amended_serial_no"/>
                            <field name="cra_payroll_acc_num"/>
                            <field name="social_insurance_number"/>
                        </group>
                        <group string="Pay Cycle Information">
                            <field name="pay_period_id"/>
                            <field name="first_day_worked"/>
                            <field name="last_day_worked"/>
                            <field name="final_pay_period_ending_date"/>
                            <field name="expected_date_of_recall"/>
                            <field name="expected_date" invisible="expected_date_of_recall != 'expected_date_recall'"/>
                        </group>
                        <group string="Insurable hour and earning Information">
                            <field name="total_insurable_hours"/>
                            <field name="total_insurable_earnings"/>
                        </group>
                        <group string="Separation Payments">
                            <field name="vacation_pay_amount"/>
                            <field name="vacation_pay_start_date"/>
                            <field name="vacation_pay_end_date"/>
                            <field name="statutory_holiday_pay_amount"/>
                        </group>
                        <group string="Reason For Issuing the roe">
                            <field name="reason_for_issuing_roe"/>
                            <field name="comments"/>
                        </group>
                    </group>
                    <notebook>
                        <page name="payslips" string="Payslips">
                            <sheet>
                                <field name="payslip_ids"><list create="false" default_order="number asc" delete="false">
<!--                                        <field name="number"/>-->
                                        <field name="name"/>
                                        <field name="pay_cycle_period"/>
                                        <field name="date_to"/>
                                        <field name="insurable_hour"/>
                                        <field name="insurable_earning"/>
                                    </list></field>
                            </sheet>
                        </page>
                        <page name="vac_pay" string="Vacation Pay">
                            <sheet>
<!--                                <field name="vacation_pay_ids"><list create="false" default_order="paid_date asc" delete="false">-->
<!--                                        <field name="employee_id"/>-->
<!--                                        <field name="duration"/>-->
<!--                                        <field name="paid_date"/>-->
<!--                                        <field decoration-info="state == 'draft'" decoration-success="state == state in ('validate','paid')" decoration-warning="state in ('refuse','cancel')" name="state" widget="badge"/>-->
<!--                                        <field name="vacation_pay_amount"/>-->
<!--                                        <field name="is_last_pay"/>-->
<!--                                    </list></field>-->
                                 <field name="vacation_amount_ids"><list create="false" default_order="reference asc" delete="false">
                                        <field name="reference"/>
                                        <field name="payslip_id"/>
                                        <field name="vacation_pay_type" widget="many2many_tags"/>
                                        <field name="amount"/>
<!--                                        <field decoration-info="state == 'draft'" decoration-success="state == state in ('validate','paid')" decoration-warning="state in ('refuse','cancel')" name="state" widget="badge"/>-->
<!--                                        <field name="vacation_pay_amount"/>-->
<!--                                        <field name="is_last_pay"/>-->
                                    </list></field>
                            </sheet>
                        </page>
                    </notebook>
                </sheet>
<chatter/>
            </form></field>
    </record>
    <record id="view_record_of_employee_list" model="ir.ui.view">
        <field name="name">record.of.employee.list</field>
        <field name="model">record.of.employee</field>
        <field name="arch" type="xml">
            <list>
                <field name="employee_id"/>
                <field name="company_id"/>
                <!--                <field name="serial_no"/>-->
                <!--                <field name="amended_serial_no"/>-->
                <!--                <field name="employer_payroll_ref"/>-->
                <!--                <field name="cra_payroll_acc_num"/>-->
                <!--                <field name="social_insurance_number"/>-->
                <!--                <field name="occupation"/>-->
                <!--                <field name="total_insurable_hours"/>-->
                <!--                <field name="total_insurable_earnings"/>-->
                <field name="reason_for_issuing_roe"/>
                <!--                <field name="name_of_issuer_id"/>-->
            </list></field>
    </record>
    <record id="view_record_of_employee_search" model="ir.ui.view">
        <field name="name">record.of.employee.search</field>
        <field name="model">record.of.employee</field>
        <field name="arch" type="xml">
            <search string="ROE">
                <field name="employee_id"/>
                <field name="company_id"/>
                <field name="serial_no"/>
                <field name="amended_serial_no"/>
                <field name="employer_payroll_ref"/>
                <field name="cra_payroll_acc_num"/>
                <field name="pay_period_id"/>
                <field name="social_insurance_number"/>
                <field name="first_day_worked"/>
                <field name="last_day_worked"/>
                <field name="final_pay_period_ending_date"/>
                <field name="occupation"/>
                <field name="total_insurable_hours"/>
                <field name="total_insurable_earnings"/>
                <field name="reason_for_issuing_roe"/>
                <field name="expected_date_of_recall"/>
                <field name="vacation_pay_amount"/>
                <field name="vacation_pay_start_date"/>
                <field name="vacation_pay_end_date"/>
                <field name="statutory_holiday_pay_amount"/>
                <field name="comments"/>
                <field name="language"/>
                <field name="telephone_no"/>
                <field name="name_of_issuer_id"/>
            </search></field>
    </record>
    <record id="action_record_of_employee" model="ir.actions.act_window">
        <field name="name">ROE</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">record.of.employee</field>
        <field name="view_mode">list,form</field>
    </record>
    <!--    <menuitem id="menu_roe"-->
    <!--              name="ROE"-->
    <!--              parent="menu_record_of_employment_root"-->
    <!--              action="action_record_of_employee"-->
    <!--              sequence="12"/>-->

    <record model="ir.actions.server" id="action_download_roe">
       <field name="name">Download Batch ROE Merged PDF</field>
       <field name="model_id" ref="record_of_employment.model_record_of_employee"/>
       <field name="binding_model_id" ref="record_of_employment.model_record_of_employee"/>
        <field name="binding_view_types">tree</field>
       <field name="state">code</field>
       <field name="code">
            action = records.download_roe_pdf(is_bulk=True)
       </field>
    </record>

    <record model="ir.actions.server" id="action_download_roe_batch_xml">
       <field name="name">Send Batch ROE XML via Email</field>
       <field name="model_id" ref="record_of_employment.model_record_of_employee"/>
       <field name="binding_model_id" ref="record_of_employment.model_record_of_employee"/>
        <field name="binding_view_types">tree</field>
       <field name="state">code</field>
       <field name="code">
            action = records.send_roe_xml_batch()
       </field>
    </record>
</odoo>
