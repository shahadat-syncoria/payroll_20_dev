<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_hr_employee_form" model="ir.ui.view">
            <field name="name">hr.employee.form</field>
            <field name="model">hr.employee</field>
            <field name="inherit_id" ref="hr.view_employee_form"/>
            <field name="arch" type="xml">
                <xpath expr="//page[@name='sync_payroll_vac_info']" position="after">
                    <page name="sync_roe_paycycle" string="Previous Paycycle For ROE" groups="hr.group_hr_manager">
                                    <group string="Vacation Slab Configuration">
                                        <field name="roe_paycycle_ids" no_label="1" >
                                            <list>
                                                <field name="pay_period_date" />
                                                <field name="insurable_earning" />
                                                <field name="insurable_hour" />
                                            </list>
                                        </field>
                                </group>

                            </page>
                </xpath>
            </field>
        </record>
    </data>
</odoo>