<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_hr_employee_form_overtime" model="ir.ui.view">
            <field name="name">hr.employee.overtime.form</field>
            <field name="model">hr.employee</field>
            <field name="inherit_id" ref="hr.view_employee_form"/>
            <field name="arch" type="xml">
                <xpath expr="//group[@name='application_group']" position="before">

                        <group string="Overtime">
                            <field name="overtime_method" required="1"/>
                        </group>

                </xpath>
                <xpath expr="//div[@name='button_box']" position="inside">
                    
                    <button type="object" class="oe_stat_button" id="open_overtime"
                    icon="fa-money" name="action_open_overtime_store" >
                      <div class="o_stat_info">
                        <span class="o_stat_value text-success" invisible="total_stored_overtime_amount &lt; 0">
                            <field name="total_stored_overtime_amount"/>
                        </span>
                        <span class="o_stat_value text-danger" invisible="total_stored_overtime_amount &gt;= 0">
                            <field name="total_stored_overtime_amount" />
                        </span>
                        <span class="o_stat_text">Stored Overtime</span>
                    </div>
                </button>
                </xpath>

            </field>
        </record>
    </data>
</odoo>