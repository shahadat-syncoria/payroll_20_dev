<odoo>
    <!-- Inherit Form View to Modify it -->
    <record id="hr_contract_form_overtime" model="ir.ui.view">
        <field name="name">hr.contract.form.overtime</field>
        <field name="model">hr.contract</field>
        <field name="inherit_id" ref="hr_contract.hr_contract_view_form"/>
        <field name="arch" type="xml">

            <xpath expr="//group[@name='yearly_benefits']" position="before">
                <!-- Add your fields or attributes here -->
                <group name="Overtime">
                    <label for="overtime_threshold"/>
                    <div class="o_row mw-50" name="overtime_threshold">
                        <field name="overtime_threshold" class="oe_inline o_hr_narrow_field" nolabel="1"/>
                        <div class="mb-3" name="wage_period_label">/week</div>
                    </div>
                </group>
                <!--                <field name="overtime_threshold"/>-->
            </xpath>

        </field>
    </record>

</odoo>

