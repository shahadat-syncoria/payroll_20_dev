<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- list View for Thresholds -->
    <record id="view_overtime_threshold_tree" model="ir.ui.view">
        <field name="name">overtime.thresholds.list</field>
        <field name="model">overtime.thresholds</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
            </list>
        </field>
    </record>

    <!-- Form View for Thresholds -->
    <record id="view_overtime_threshold_form" model="ir.ui.view">
        <field name="name">overtime.thresholds.form</field>
        <field name="model">overtime.thresholds</field>
        <field name="arch" type="xml">
            <form string="Overtime Threshold">
                <sheet>
                    <group>
                        <field name="name"/>
                    </group>
                    <group>
                        <field name="line_ids">
                        <list editable="bottom">
                            <field name="work_entry_id"/>
                            <field name="start_threshold"/>
                            <field name="end_threshold"/>
                            <field name="overtime_rate"/>
                        </list>
                    </field>
                    </group>
<!--                    -->
                </sheet>
            </form>
        </field>
    </record>

    <!-- list View for Lines (if needed standalone) -->
    <record id="view_overtime_threshold_line_tree" model="ir.ui.view">
        <field name="name">overtime.thresholds.line.list</field>
        <field name="model">overtime.thresholds.line</field>
        <field name="arch" type="xml">
            <list>
                <field name="overtime_threshold_id"/>
                <field name="start_threshold"/>
                <field name="end_threshold"/>
                <field name="overtime_rate"/>
            </list>
        </field>
    </record>

    <!-- Menu and Action -->
    <menuitem id="menu_overtime_root" name="Overtime Management" sequence="10"/>

    <record id="action_overtime_thresholds" model="ir.actions.act_window">
        <field name="name">Overtime Thresholds</field>
        <field name="res_model">overtime.thresholds</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create an Overtime Threshold Policy</p>
        </field>
    </record>

    <menuitem id="menu_overtime_thresholds"
              name="Overtime Thresholds"
              parent="syncoria_can_payroll.menu_hr_salary_tax_configuration"
              action="action_overtime_thresholds"
              sequence="10"/>
</odoo>
