<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="hr_payslip_form_overtime" model="ir.ui.view">
            <field name="name">hr_payslip.overtime.form</field>
            <field name="model">hr.payslip</field>
            <field name="inherit_id" ref="hr_payroll.view_hr_payslip_form"/>
            <!--            <field name="priority" eval="8"/>-->
            <field name="arch" type="xml">
                <xpath expr="//div[@name='button_box']" position="inside">
                  <button type="object" class="oe_stat_button" id="open_overtime"
                    icon="fa-money" name="action_open_overtime" >
                      <div class="o_stat_info">
                        <span class="o_stat_value text-success" invisible="total_stored_overtime_amount &lt; 0">

                            <field name="currency_id" />
                            <field name="total_stored_overtime_amount" />
                        </span>
                        <span class="o_stat_value text-danger" invisible="total_stored_overtime_amount &gt;= 0">
                            <field name="currency_id"/>
                            <field name="total_stored_overtime_amount"/>
                        </span>
                        <span class="o_stat_text">Stored Overtime</span>
                    </div>
                </button>
            </xpath>
            </field>
        </record>

    </data>
</odoo>
