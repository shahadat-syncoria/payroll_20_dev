<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="hr_overtime_pay_form_view" model="ir.ui.view">
            <field name="name">syncoria_can_overtime_pay.hr_overtime_pay.form</field>
            <field name="model">hr.overtime.pay.request</field>
            <field name="arch" type="xml">
                <form string="Overtime Pay Request">
                    <header>
                        <button class="oe_highlight" invisible="state != 'draft'" name="action_confirm" string="Confirm" type="object"/>
                        <button class="oe_highlight" groups="hr_holidays.group_hr_holidays_manager" invisible="state != 'confirm'" name="action_approve" string="Approve" type="object"/>
                        <button class="oe_highlight" groups="hr_holidays.group_hr_holidays_manager,hr_holidays.group_hr_holidays_user" invisible="state not in ['validate1']" name="action_validate" string="Validate" type="object"/>
                        <button groups="hr_holidays.group_hr_holidays_manager,hr_holidays.group_hr_holidays_user" invisible="state not in ('confirm', 'cancel', 'validate')" name="action_refuse" string="Refuse" type="object"/>
                        <button invisible="state != 'draft'" name="action_cancel" string="Cancel" type="object"/>
                        <button invisible="state not in ['cancel', 'refuse']" name="action_draft" string="Mark as Draft" type="object"/>
                        <field name="state" statusbar_visible="confirm,validate" widget="statusbar"/>
                    </header>
                    <sheet>

                        <div class="oe_title">
                            <label for="name" string="Reference"/>
                            <h1>
                                <field name="name" placeholder="Reference"/>
                            </h1>
                        </div>
                        <group>
                            <group string="Employee Information">
                                <field groups="hr_holidays.group_hr_holidays_manager,hr_holidays.group_hr_holidays_user" name="employee_id"/>
                                <field name="department_id"/>
                                <field name="job_id"/>
                                <field name="contract_id"/>
                                <field name="description"/>
                            </group>
                            <group string="Overtime Pay Request Information">
                                <field name="date" readonly="0"/>
                                <field name="remaining_overtime" readonly="1"/>
                                <field name="overtime_pay" readonly="state != 'draft'"/>

                            </group>
                        </group>
                    </sheet>
                    <div class="oe_chatter">
                        <field groups="base.group_user" name="message_follower_ids"/>
                        <field name="activity_ids"/>
                        <field name="message_ids"/>
                    </div>
                </form></field>
        </record>
        <record id="hr_overtime_pay_list_view" model="ir.ui.view">
            <field name="name">syncoria_can_overtime_pay.hr_overtime_pay.list</field>
            <field name="model">hr.overtime.pay.request</field>
            <field name="arch" type="xml">
                <list string="Overtime Pay Request">
                    <field name="name"/>
                    <field name="employee_id"/>
                    <field decoration-info="state == 'draft'" decoration-success="state == state in ('validate','paid')" decoration-warning="state in ('refuse','cancel')" name="state" widget="badge"/>
                </list></field>
        </record>
        <record id="hr_overtime_pay_search_view" model="ir.ui.view">
            <field name="name">syncoria_can_overtime_pay.hr_overtime_pay.search</field>
            <field name="model">hr.overtime.pay.request</field>
            <field name="arch" type="xml">
                <search string="Overtime Pay Request">
                    <field name="employee_id"/>
                    <group expand="1" string="Group By">
                        <filter context="{'group_by':'employee_id'}" domain="[]" name="group_employee_id" string="Employee"/>
                    </group>
                </search>
                <!--                <searchpanel>-->
                <!--                    <field name="state" string="Status"/>-->
                <!--                    <field name="department_id" string="Department"/>-->
                <!--                </searchpanel>--></field>
        </record>
        <record id="hr_overtime_pay_act_window" model="ir.actions.act_window">
            <field name="name">Overtime Pay Request</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">hr.overtime.pay.request</field>
            <field name="view_mode">list,form</field>
            <field name="context">{}</field>
            <field name="help" type="html">
                <p class="oe_view_nocontent_create">
                    There is no examples click here to add new Overtime Pay Request.
                </p></field>
        </record>
        <menuitem action="hr_overtime_pay_act_window" id="hr_overtime_pay_menu" name="Overtime Pay Request" parent="hr_holidays.menu_hr_holidays_my_leaves" sequence="20"/>
    </data>
</odoo>
