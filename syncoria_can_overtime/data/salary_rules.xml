<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!--        ===================== Employee ===========================-->
        <record id="rule_ca_overtime_pay" model="hr.salary.rule">
            <field name="country_id" ref="base.ca"/>
            <field name="name">Overtime</field>
            <field name="sequence" eval="70"/>
            <field name="code">OVERTIME</field>
            <field name="category_ids" eval="[(6, 0, [ref('hr_payroll.GROSS')])]"/>
            <field name="appears_on_payslip" eval="'always'"/>
            <field name="active" eval="1"/>
            <field name="amount_select">code</field>
            <field name="struct_ids" eval="[(6, 0, [ref('syncoria_can_payroll.structure_can_employee')])]"/>
            <field name="condition_select">python</field>
            <field name="condition_python">result = 'CAN_OVERTIME' in worked_days</field>

            <field name="amount_python_compute">
result = worked_days['CAN_OVERTIME'].amount
result_name = worked_days['CAN_OVERTIME'].name
            </field>
        </record>


        <record id="rule_ca_stat_overtime_pay" model="hr.salary.rule">
            <field name="country_id" ref="base.ca"/>
            <field name="name">Statutory Holiday Overtime</field>
            <field name="sequence" eval="75"/>
            <field name="code">STAT_OVERTIME</field>
            <field name="category_ids" eval="[(6, 0, [ref('syncoria_can_payroll.additional_allowance')])]"/>
            <field name="appears_on_payslip" eval="'always'"/>
            <field name="active" eval="1"/>
            <field name="amount_select">code</field>
            <field name="struct_ids" eval="[(6, 0, [ref('syncoria_can_payroll.structure_can_employee')])]"/>
            <field name="condition_select">python</field>
            <field name="condition_python">result = 'CAN_STAT_OVERTIME' in worked_days</field>

            <field name="amount_python_compute">
result = worked_days['CAN_STAT_OVERTIME'].amount
result_name = worked_days['CAN_STAT_OVERTIME'].name
            </field>
        </record>

        <record id="rule_ca_banked_overtime_pay" model="hr.salary.rule">
            <field name="country_id" ref="base.ca"/>
            <field name="name">BankedOvertime</field>
            <field name="sequence" eval="70"/>
            <field name="code">BNK_OVERTIME</field>
            <field name="category_ids" eval="[(6, 0, [ref('syncoria_can_payroll.additional_allowance')])]"/>
            <field name="appears_on_payslip" eval="'always'"/>
            <field name="active" eval="1"/>
            <field name="amount_select">code</field>
            <field name="struct_ids" eval="[(6, 0, [ref('syncoria_can_payroll.structure_can_employee')])]"/>
            <field name="input_usage_payslip" eval="1"/>
            <field name="condition_select">python</field>
            <field name="condition_python">result = 'BNK_OVERTIME' in inputs</field>

            <field name="amount_python_compute">
result = inputs['BNK_OVERTIME'].amount
result_name = inputs['BNK_OVERTIME'].name
            </field>
        </record>


